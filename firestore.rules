rules_version = '2';

// HGWS – Firestore biztonsági szabályok
// Másold be: Firebase Console → Firestore Database → Rules → Publish
//
// Rangok (users/{uid}.role) – a jogokat a „roles” gyűjtemény adja, ha nincs dokumentum, az alábbi alapértékek:
//   owner       – 👑 TULAJ: be van égetve (ownerId), mindent tud, őt senki nem tilthatja, némíthatja, nem veheti el a rangját
//   admin       – minden jog; rangot csak kérelmezhet (a tulaj hagyja jóvá), admint csak a tulaj adhat
//   szerkeszto  – moderátori jogok + film/zene beküldése (admin hagyja jóvá)
//   moderator   – némítás, tiltás (alacsonyabb rangúaknál), üzenettörlés, tagek, ötletek megválaszolása
//   user        – csevegés, filmnézés, értékelés, ötletek beküldése
//   vendég      – Firebase névtelen (Anonymous) belépés: csak filmnézés, olvasás
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function profilePath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function active() { return verified() && hasProfile() && me().get('banned', false) != true; }
    function notMuted() { return me().get('mutedUntil', null) == null || me().mutedUntil < request.time; }
    function canPost() { return active() && notMuted(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- tulaj és jogosultságok ----------
    function ownerId() { return 'bzKz3gAS55hLmf3pru7Ljw0NETN2'; }
    function isOwner() { return signedIn() && request.auth.uid == ownerId(); }
    function defaultPerms() {
      return {
        'admin': {'moderate': true, 'deleteMessages': true, 'announce': true, 'manageTags': true, 'tickets': true,
                  'submitMedia': true, 'publishMedia': true, 'manageChannels': true, 'assignRoles': true},
        'szerkeszto': {'moderate': true, 'deleteMessages': true, 'announce': true, 'manageTags': true, 'tickets': true, 'submitMedia': true},
        'moderator': {'moderate': true, 'deleteMessages': true, 'announce': true, 'manageTags': true, 'tickets': true},
        'user': {}
      };
    }
    function defaultRanks() { return {'owner': 100, 'admin': 80, 'szerkeszto': 60, 'moderator': 40, 'user': 10}; }
    function rolePath(r) { return /databases/$(db)/documents/roles/$(r); }
    function roleExists(r) { return r in defaultRanks() || exists(rolePath(r)); }
    function rankOf(r) { return r != 'owner' && exists(rolePath(r)) ? get(rolePath(r)).data.rank : defaultRanks().get(r, 0); }
    function myRole() { return me().get('role', 'user'); }
    function myRank() { return isOwner() ? 1000 : rankOf(myRole()); }
    function userRank(uid) {
      return uid == ownerId() ? 1000 : rankOf(get(/databases/$(db)/documents/users/$(uid)).data.get('role', 'user'));
    }
    function perm(p) {
      return isOwner() || (active() && (exists(rolePath(myRole()))
        ? get(rolePath(myRole())).data.get('perms', {}).get(p, false) == true
        : defaultPerms().get(myRole(), {}).get(p, false) == true));
    }

    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 32; }

    // Foglalt nevek: a hgery / hgery08 / Halász Gergely bármilyen változatát csak a tulajdonos használhatja
    function reservedName(n) {
      let s = n.lower();
      let A = '[aáà4@]';
      let E = '[eéè3]';
      let sep = '[^a-z0-9áéíóöőúüű]*';
      let hgery = '.*h' + sep + '[g69]' + sep + E + sep + 'r' + sep + '[yií1].*';
      let halasz = '.*h' + sep + A + sep + 'l' + sep + A + sep + 's' + sep + 'z.*';
      let gergely = '.*[g69]' + sep + E + sep + 'r' + sep + '[g69]' + sep + E + sep + 'l' + sep + '[yií1].*';
      return s.matches(hgery)
        || (s.matches(halasz) && s.matches(gergely))
        || s.matches('(.*[^a-z]|)h[^a-z]+' + '[g69]' + sep + E + sep + 'r' + sep + '[g69]' + sep + E + sep + 'l' + sep + '[yií1].*')
        || s.matches('.*h' + sep + A + sep + 'l' + sep + A + sep + 's' + sep + 'z[^a-z]+[g69]([^a-z].*|)');
    }
    // NEVSZURO-START – generálva a js/nevszuro.js listáiból (node tools/nevszuro.mjs), kézzel ne írd át
    function nameNorm(n) {
      return n.lower().replace('[áàâä]', 'a').replace('[éèêë]', 'e').replace('[íìîï]', 'i').replace('[óòôöő]', 'o').replace('[úùûüű]', 'u')
        .replace('[çčć]', 'c').replace('ñ', 'n').replace('š', 's').replace('ž', 'z').replace('ř', 'r').replace('ý', 'y')
        .replace('[4@]', 'a').replace('3', 'e').replace('[1!|]', 'i').replace('0', 'o').replace('[5$]', 's').replace('7', 't')
        .replace('q', 'k').replace('ph', 'f').replace('cz', 'c').replace('w', 'v')
        .replace('[^a-z]+', ' ').trim();
    }
    function badName(n) {
      let sp = ' ' + nameNorm(n).replace('(scunthorpe|pornoapati|ciganyzene|kurvenbau|retardalo|penistone|agrippina|therapist|shiitake|cocktail|assassin|pinatubo|pussycat|buzinkai|shitake|hancock|peacock|cockpit|dickens|dickson|passion|compass|spinach|basszus|cigaret|arsenal|szopran|fosszil|foszfor|puttony|sussex|seggio|titsch|putnok|essex|sukar)', '_') + ' ';
      return !n.matches("^[A-Za-z0-9ÁÉÍÓÖŐÚÜŰáéíóöőúüűÄËÏäëïÀÈÌÒÙàèìòùÂÊÎÔÛâêîôûÇçÑñČčŠšŽžĆćŘřÝý .'_-]+$")
        || sp.replace(' ', '').matches('.*(k+u+r+v+a+|k+r+v+a+|k+u+r+v+a+n+y+|f+a+s+z+|p+i+c+s+a+|p+u+n+c+i+|p+i+n+a+s+|p+i+n+a+j+|p+i+n+a+f+e+j+|p+i+n+a+n+y+a+l+o+|g+e+c+i+|b+u+z+i+|b+u+z+e+r+a+n+|k+o+c+s+o+g+|s+e+g+g+|b+a+z+m+e+g+|b+a+z+d+m+e+g+|b+a+z+z+e+g+|b+a+s+z+d+|b+a+s+z+o+|b+a+s+z+n+|b+a+s+z+t+|b+a+s+z+i+|b+a+s+z+h+|b+a+s+z+a+s+|b+a+s+s+z+a+m+|b+a+s+s+z+o+n+|b+a+s+s+z+a+d+|b+a+s+z+k+i+|k+i+b+a+s+z+|e+l+b+a+s+z+|m+e+g+b+a+s+z+|l+e+b+a+s+z+|s+z+e+t+b+a+s+z+|f+e+l+b+a+s+z+|s+z+a+r+h+a+z+i+|s+z+a+r+f+e+j+|s+z+a+r+z+s+a+k+|s+z+a+r+c+s+i+m+b+o+k+|k+u+t+y+a+s+z+a+r+|f+o+s+t+a+l+i+c+s+k+a+|f+o+s+f+e+j+|a+n+y+a+d+a+t+|a+n+y+a+d+b+a+|k+u+r+v+a+a+n+y+a+d+|r+i+b+a+n+c+|l+o+t+y+o+|r+i+n+g+y+o+|s+z+a+j+h+a+|c+a+f+k+a+|r+o+h+a+d+e+k+|c+s+i+c+s+k+a+|s+z+o+p+o+|s+z+o+p+j+|s+z+o+p+d+|s+z+o+p+a+s+|s+z+o+p+a+t+|l+e+s+z+o+p+|p+o+c+s+f+e+j+|f+u+t+y+i+|c+i+g+a+n+y+|n+e+g+e+r+|n+i+g+g+e+r+|n+i+g+g+a+|n+i+g+g+|z+s+i+d+o+z+o+|f+a+s+z+o+m+|m+e+g+d+u+g+|m+e+g+[dk]+e+f+|k+e+f+e+l+|k+u+r+o+l+|g+e+n+n+y+e+s+|t+o+k+f+e+j+|h+e+r+e+g+o+l+y+o+|p+e+d+o+f+i+l+|h+i+t+l+e+r+|s+t+r+i+c+i+|p+r+o+s+t+i+|m+a+s+z+t+u+r+b+|r+e+j+s+z+o+l+|s+e+g+g+f+e+j+|s+e+g+g+n+y+a+l+o+|s+e+g+g+l+y+u+k+|h+u+g+y+o+s+|r+e+t+a+r+d+a+l+t+|b+u+z+i+z+s+|p+i+n+a+s+z+o+r+|f+u+c+k+|f+v+c+k+|s+h+i+t+|b+i+t+c+h+|b+i+a+t+c+h+|c+u+n+t+|v+h+o+r+e+|s+l+u+t+|p+u+s+s+y+|a+s+s+h+o+l+e+|a+r+s+e+h+o+l+e+|d+i+c+k+h+e+a+d+|c+o+c+k+s+u+c+k+|f+a+g+g+o+t+|m+o+t+h+e+r+f+|p+o+r+n+|p+e+n+i+s+|v+a+g+i+n+a+|b+o+o+b+|t+i+t+t+i+e+s+|v+a+n+k+|b+a+s+t+a+r+d+|j+e+r+k+o+f+f+|b+l+o+v+j+o+b+|h+a+n+d+j+o+b+|c+u+m+s+h+o+t+|j+i+z+z+|d+i+l+d+o+|r+a+p+i+s+t+|m+o+l+e+s+t+|h+e+n+t+a+i+|p+e+d+o+p+h+i+l+e+|k+i+l+l+y+o+u+r+s+e+l+f+|s+c+h+l+a+m+p+e+|s+c+h+e+i+s+s+e+|a+r+s+c+h+l+o+c+h+|f+o+t+z+e+|h+u+r+e+n+s+o+h+n+|v+i+c+h+s+e+r+|p+e+n+d+e+j+o+|b+l+y+a+t+|c+y+k+a+|p+i+z+d+a+|j+e+b+a+c+|s+a+l+o+p+e+|p+u+t+a+i+n+).*')
        || sp.matches('.* (p+i+n+a+|p+o+c+s+|f+o+s+|k+u+k+i+|a+n+y+a+d+|c+i+g+o+|c+s+o+c+s+|c+i+c+i+|d+i+d+i+|p+e+d+o+|n+a+c+i+|n+y+i+l+a+s+|s+z+u+k+a+|h+u+g+y+|o+n+d+o+|s+p+e+r+m+a+|s+z+e+x+|p+o+r+n+o+|r+e+t+a+r+d+|k+r+e+t+e+n+|k+u+r+a+f+i+|f+a+t+t+y+u+|g+e+n+y+|f+u+k+|f+c+k+|c+o+c+k+|c+u+m+|a+n+a+l+|a+n+u+s+|r+a+p+e+|s+e+x+|s+e+x+y+|n+u+d+e+|n+a+k+e+d+|h+o+r+n+y+|m+i+l+f+|t+i+t+s+|t+v+a+t+|p+r+i+c+k+|n+a+z+i+|k+k+k+|k+y+s+|n+e+g+r+o+|k+i+k+e+|c+h+i+n+k+|s+p+i+c+|t+r+a+n+n+y+|f+a+g+|s+u+k+a+|p+u+t+a+|c+h+u+j+|m+e+r+d+e+|m+i+e+r+d+a+)(s|k|ok|ek|ak)? .*');
    }
    // NEVSZURO-END
    // a név akkor jó, ha nem foglalt – vagy ha a tulaj fiókjáról van szó
    function nameAllowed(uid, n) { return (!reservedName(n) || uid == ownerId()) && !badName(n); }

    // HGWS matricák és saját emojik – csak ezek az azonosítók küldhetők (img/stickers/hgws/stickers.json)
    function stickerIds() { return ['szilard_nevet', 'szilard_duhos', 'szilard_azott', 'szilard_megszaritalak', 'szilard_laza', 'locsolofej_ragyog', 'locsolofej_megvan', 'locsolofej_sziv', 'csepp_boldog', 'csepp_sir', 'csepp_szivszem', 'csepp_nevet', 'csepp_gondolkodik', 'csepp_alszik', 'csepp_plusz1', 'novenyke', 'kaktusz_rip', 'hgws_approved', 'szlogen', 'locsolj', 'gg']; }
    // reakcióként csak a választó emojijai és a saját emojik kódjai használhatók (js/ui.js EMOJIS + stickers.json)
    function reactionKeys() { return ['👍', '❤️', '😂', '🔥', '💧', '😮', '😢', '😡', '🎉', '👏', '🙏', '💯', '😎', '🤔', '👀', '🤣', '😍', '🥲', '😅', '🙃', '🤝', '💪', '🚿', '🌱', '🌊', '🏆', '⭐', '✅', '❌', '🍿', '🎬', '🎮',
      ':szilard:', ':szilard_duhos:', ':szilard_azott:', ':locsolofej:', ':csepp:', ':csepp_sir:', ':csepp_szivszem:', ':csepp_nevet:', ':hgws:', ':approved:', ':kaktusz:', ':novenyke:']; }

    // új üzenet formai ellenőrzése
    function validMsg() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.text is string && d.text.size() <= 4000
        && d.keys().hasOnly(['uid', 'text', 'createdAt', 'film', 'track', 'replyTo', 'reactions', 'poll', 'sticker'])
        && (d.text.size() > 0 || d.get('film', null) is string || d.get('track', null) is string || 'sticker' in d)
        && (!('poll' in d) || (d.poll.q is string && d.poll.q.size() <= 200 && d.poll.opts is list && d.poll.opts.size() >= 2 && d.poll.opts.size() <= 6))
        // matrica: külön üzenettípus, szöveg és melléklet nélkül, csak ismert azonosítóval
        && (!('sticker' in d) || (d.sticker is string && d.sticker in stickerIds() && d.text == ''
            && !('poll' in d) && !('film' in d) && !('track' in d)));
    }
    // saját üzenet szerkesztése vagy bárki reagál
    function msgUpdate() {
      return (canPost() && resource.data.uid == request.auth.uid && !('sticker' in resource.data)
              && changed().hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string && request.resource.data.text.size() <= 4000)
          || (active() && changed().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly(reactionKeys()))
          // szavazás: mindenki csak a saját szavazatát állíthatja
          || (canPost() && 'poll' in resource.data && changed().hasOnly(['pv'])
            && request.resource.data.pv.diff(resource.data.get('pv', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.pv)
              || (request.resource.data.pv[request.auth.uid] is int && request.resource.data.pv[request.auth.uid] >= 0
                && request.resource.data.pv[request.auth.uid] < resource.data.poll.opts.size())));
    }

    // ---------- vendégek jelenléte (Online lista) – a vendég csak a saját becenevét és idejét írhatja ----------
    match /guests/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['nick', 'lastSeen'])
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 20 && request.resource.data.nick.matches('^[^<>&"]+$')
        && request.resource.data.lastSeen == request.time;
      allow delete: if request.auth.uid == uid || perm('publishMedia');
    }

    // ---------- e-mail címek: CSAK az adminok és a tulaj olvashatják ----------
    // A tag kizárólag a saját, a belépési tokenjében szereplő címét írhatja be – más nevében vagy hamis címmel nem.
    match /emails/{uid} {
      allow get: if isOwner() || perm('publishMedia') || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner() || perm('publishMedia');
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- felhasználók ----------
    match /users/{uid} {
      // a nevek a hozzászólásokhoz kellenek, ezért a vendégek is olvashatják
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'color', 'role', 'banned', 'createdAt', 'lastSeen', 'photoURL', 'bio'])
        && (request.resource.data.role == 'user' || (uid == ownerId() && request.resource.data.role == 'owner'))
        && request.resource.data.banned == false
        && validName(request.resource.data.name)
        && nameAllowed(uid, request.resource.data.name);

      // A TULAJ profilját csak ő maga módosíthatja – senki nem tilthatja, némíthatja, nem veheti el a rangját.
      allow update: if (uid == ownerId() && isOwner()
          && changed().hasOnly(['name', 'nameLower', 'bio', 'color', 'lastSeen', 'photoURL', 'role', 'tags', 'banned', 'mutedUntil'])
          && (!('role' in changed()) || request.resource.data.role == 'owner') && request.resource.data.get('banned', false) == false
          && validName(request.resource.data.name)
          && request.resource.data.get('bio', '').size() <= 300)
        || (uid != ownerId() && (
          // saját profil
          (signedIn() && request.auth.uid == uid
            && changed().hasOnly(['name', 'nameLower', 'bio', 'color', 'lastSeen', 'photoURL'])
            && validName(request.resource.data.name)
            && (!('name' in changed()) || nameAllowed(uid, request.resource.data.name))
            && request.resource.data.get('bio', '').size() <= 300)
          // rangot közvetlenül CSAK a tulaj adhat (a többiek kérelmet küldenek: roleRequests)
          || (isOwner() && request.resource.data.get('role', 'user') != 'owner' && roleExists(request.resource.data.get('role', 'user'))
            && (!('name' in changed()) || (validName(request.resource.data.name) && nameAllowed(uid, request.resource.data.name))))
          // moderálás: némítás, tiltás, átnevezés – csak nála alacsonyabb rangúnál
          || (perm('moderate') && request.auth.uid != uid && rankOf(resource.data.get('role', 'user')) < myRank()
            && changed().hasOnly(['banned', 'mutedUntil', 'name', 'nameLower'])
            && (!('name' in changed()) || (validName(request.resource.data.name) && nameAllowed(uid, request.resource.data.name))))
          // tagek kiosztása
          || (perm('manageTags') && changed().hasOnly(['tags'])
            && request.resource.data.tags is list && request.resource.data.tags.size() <= 10)
        ));

      allow delete: if isOwner() && uid != ownerId();

      // saját olvasottsági jelölők stb.
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // értesítések: a cselekvő tag írja a címzettnek, csak a címzett olvashatja / jelölheti olvasottnak / törölheti
      match /notifs/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && changed().hasOnly(['read']);
        allow create: if (active() || (signedIn() && request.auth.uid == uid))
          && request.resource.data.keys().hasOnly(['type', 'text', 'link', 'by', 'at', 'read'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && request.resource.data.link is string && request.resource.data.link.size() <= 200
          && request.resource.data.type in ['mention', 'idea', 'approve', 'reject', 'role', 'tag', 'premiere', 'party', 'vote', 'badge', 'friend', 'game']
          && (request.resource.data.type != 'badge' || request.auth.uid == uid);   // kitüntetésről csak saját magának írhat
      }
    }

    // ---------- rangok (a tulaj szerkeszti) ----------
    match /roles/{rid} {
      allow read: if signedIn();
      allow create, update: if isOwner() && rid != 'owner'
        && request.resource.data.keys().hasOnly(['name', 'color', 'rank', 'perms'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.rank is int && request.resource.data.rank >= 1 && request.resource.data.rank <= 99
        && request.resource.data.perms is map;
      allow delete: if isOwner();
    }

    // ---------- rangkérelmek: admin kéri, a tulaj hagyja jóvá ----------
    match /roleRequests/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if perm('assignRoles')
        && request.resource.data.keys().hasOnly(['target', 'role', 'prev', 'by', 'at', 'status'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time
        && request.resource.data.role != 'owner' && request.resource.data.role != 'admin'
        && roleExists(request.resource.data.role)
        && rankOf(request.resource.data.role) < myRank()
        && request.resource.data.target != ownerId() && request.resource.data.target != request.auth.uid
        && userRank(request.resource.data.target) < myRank();
      allow update: if isOwner() && changed().hasOnly(['status', 'reviewedAt']);
      allow delete: if isOwner() || (signedIn() && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }

    // ---------- film- és zenebeküldések: szerkesztő küldi, admin hagyja jóvá ----------
    match /submissions/{id} {
      allow read: if perm('publishMedia') || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if perm('submitMedia')
        && request.resource.data.keys().hasOnly(['type', 'action', 'targetId', 'title', 'data', 'src', 'by', 'at', 'status'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time
        && request.resource.data.type in ['film', 'music']
        && request.resource.data.action in ['create', 'update', 'delete'];
      allow update: if perm('publishMedia') && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'note'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if perm('publishMedia') || (signedIn() && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }

    // ---------- ötletek / ticketek: tag beküldi, moderátortól felfelé válaszolnak ----------
    match /ideas/{id} {
      allow read: if perm('tickets') || (signedIn() && resource.data.uid == request.auth.uid) || (active() && resource.data.get('public', false) == true);
      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'text', 'category', 'status', 'replies', 'public', 'votes', 'createdAt', 'updatedAt'])
        && request.resource.data.get('public', false) is bool && request.resource.data.get('votes', []) == []
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'nyitott' && request.resource.data.replies == 0
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.category in ['otlet', 'hiba', 'kerdes', 'egyeb']
        && request.resource.data.createdAt == request.time;
      allow update: if (perm('tickets')
          && changed().hasOnly(['status', 'updatedAt', 'replies', 'lastReplyAt', 'lastReplyBy', 'public'])
          && request.resource.data.status in ['nyitott', 'folyamatban', 'kesz', 'elutasitva'])
        || (canPost() && resource.data.uid == request.auth.uid
          && changed().hasOnly(['updatedAt', 'replies', 'lastReplyAt', 'lastReplyBy'])
          && request.resource.data.replies == resource.data.replies + 1)
        // szavazás (👍) a nyilvános ötletekre: mindenki csak a saját szavazatát teszi be / veszi ki
        || (active() && resource.data.get('public', false) == true && changed().hasOnly(['votes'])
          && request.resource.data.votes is list && request.resource.data.votes.size() <= 5000
          && request.resource.data.votes.toSet().difference(resource.data.get('votes', []).toSet())
              .union(resource.data.get('votes', []).toSet().difference(request.resource.data.votes.toSet())).hasOnly([request.auth.uid]));
      allow delete: if perm('tickets') || (signedIn() && resource.data.uid == request.auth.uid);

      match /replies/{rid} {
        function ticket() { return get(/databases/$(db)/documents/ideas/$(id)).data; }
        allow read: if perm('tickets') || (signedIn() && ticket().uid == request.auth.uid) || (active() && ticket().get('public', false) == true);
        allow create: if canPost() && (perm('tickets') || ticket().uid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if perm('tickets');
      }
    }

    // tagek: szöveg + szín, a moderátorok és adminok kezelik, mindenki (vendég is) látja
    match /tags/{tid} {
      allow read: if signedIn();
      allow create, update: if perm('manageTags')
        && request.resource.data.keys().hasOnly(['name', 'color', 'order', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
      allow delete: if perm('manageTags');
    }

    // ---------- napló (audit log): bárki írhat saját nevében, csak a tulaj és az adminok olvashatják, senki nem törölheti ----------
    match /audit/{id} {
      allow read: if isOwner() || perm('assignRoles');
      allow create: if active()
        && request.resource.data.keys().hasOnly(['by', 'action', 'target', 'detail', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.target is string && request.resource.data.target.size() <= 120
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow update, delete: if false;
    }

    // ---------- megtekintések: filmenként egy számláló, csak eggyel nőhet ----------
    match /views/{vid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && changed().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // ---------- Arcade ranglista + Drift: vendégek (névtelen belépés) is felkerülhetnek ----------
    // Nekik kötelező a „nick” (becenév) mező, a regisztráltaknál a profilnév látszik
    function isGuest() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function okNick(n) { return n is string && n.size() >= 2 && n.size() <= 20 && n.matches('^[^<>&"]+$') && !reservedName(n) && !badName(n); }
    function lbWriter(uid, extra) {
      return request.auth.uid == uid && (
        (active() && request.resource.data.keys().hasOnly(extra))
        || (isGuest() && request.resource.data.keys().hasOnly(extra.concat(['nick'])) && okNick(request.resource.data.get('nick', null))));
    }
    function nickChanged() { return isGuest() && request.resource.data.nick != resource.data.get('nick', ''); }

    // ---------- Drift Király: pályánkénti legjobb kör (szellemautó) és verseny-idő – csak javulhat ----------
    match /ghosts/{track}/runs/{uid} {
      allow read: if signedIn();
      allow create, update: if lbWriter(uid, ['ms', 'car', 'path', 'rms', 'at'])
        && request.resource.data.ms is int && request.resource.data.ms > 5000 && request.resource.data.ms <= 3600000
        && request.resource.data.rms is int && request.resource.data.rms > 10000 && request.resource.data.rms <= 3600000
        && request.resource.data.car is string && request.resource.data.car.size() < 20
        && request.resource.data.path is string && request.resource.data.path.size() < 60000
        && request.resource.data.at == request.time
        && (resource == null || (request.resource.data.ms <= resource.data.ms && request.resource.data.rms <= resource.data.rms
            && (request.resource.data.ms < resource.data.ms || request.resource.data.rms < resource.data.rms || nickChanged())));
      allow delete: if perm('publishMedia');
    }

    // ---------- Arcade ranglista: mindenki csak a saját rekordját írhatja, és csak felfelé ----------
    // wins: hányszor érte el a csúcsot (Víztorony) – egyszerre csak eggyel nőhet
    match /leaderboards/{lb}/scores/{uid} {
      allow read: if signedIn();
      allow create: if lbWriter(uid, ['best', 'at', 'wins'])
        && request.resource.data.best is number && request.resource.data.best > 0 && request.resource.data.best <= 9000000000000000
        && request.resource.data.get('wins', 0) in [0, 1]
        && request.resource.data.at == request.time;
      allow update: if lbWriter(uid, ['best', 'at', 'wins'])
        && request.resource.data.best is number && request.resource.data.best >= resource.data.best && request.resource.data.best <= 9000000000000000
        && request.resource.data.get('wins', 0) is int
        && (request.resource.data.get('wins', 0) == resource.data.get('wins', 0) || request.resource.data.get('wins', 0) == resource.data.get('wins', 0) + 1)
        && (request.resource.data.best > resource.data.best || request.resource.data.get('wins', 0) == resource.data.get('wins', 0) + 1 || nickChanged())
        && request.resource.data.at == request.time;
      // eredmény törlése: admin és tulaj
      allow delete: if perm('publishMedia');
    }

    // ---------- közös nézés ----------
    match /parties/{pid} {
      allow read: if signedIn();
      allow create: if canPost() && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'vid', 'state', 't', 'at', 'createdAt', 'members'])
        && request.resource.data.state in ['play', 'pause'];
      allow update: if (signedIn() && resource.data.host == request.auth.uid
          && changed().hasOnly(['state', 't', 'at', 'members']) && request.resource.data.state in ['play', 'pause'])
        || (signedIn() && changed().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if (signedIn() && resource.data.host == request.auth.uid) || perm('deleteMessages');
      match /msgs/{mid} {
        allow read: if signedIn();
        allow create: if canPost() && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || perm('deleteMessages');
      }
    }

    // ---------- értékelések gyűjteménycsoportként (statisztika, legjobbra értékelt, profil) ----------
    match /{path=**}/ratings/{rid} {
      allow read: if signedIn();
    }

    // Arcade heti bajnok jelölő
    match /meta/arcade {
      allow read: if signedIn();
      allow write: if perm('manageTags');
    }

    // tulajdonos jelölő (az első admin igénylésekor jön létre)
    match /meta/owner {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ---------- csatornák (Discord-szerű üzenőfalak) ----------
    match /channels/{cid} {
      allow read: if active();
      allow create, delete: if perm('manageChannels');
      allow update: if perm('manageChannels') || (canPost() && changed().hasOnly(['lastMessageAt']));

      match /messages/{mid} {
        allow read: if active();
        allow create: if canPost() && validMsg()
          && (get(/databases/$(db)/documents/channels/$(cid)).data.get('type', 'text') != 'announce' || perm('announce'));
        allow update: if msgUpdate();
        allow delete: if (active() && resource.data.uid == request.auth.uid) || (perm('deleteMessages') && resource.data.uid != ownerId());
      }
    }

    // ---------- barátok ----------
    // friends/{a_b}: a két uid ábécérendben. Kérelem: from → to, 'pending'; csak a címzett fogadhatja el.
    // Bármelyik fél törölheti (elutasítás, visszavonás, barát eltávolítása).
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendPath(a, b) { return /databases/$(db)/documents/friends/$(pairId(a, b)); }
    // csak get(): ha nincs ilyen dokumentum, a kifejezés hibára fut = nem barátok (így 1 olvasás / ellenőrzés)
    function areFriends(a, b) { return get(friendPath(a, b)).data.status == 'accepted'; }
    function friendOrMe(m) { return m == request.auth.uid || areFriends(request.auth.uid, m); }
    // legfeljebb 8 új tag egy lépésben (a szabályok dokumentum-olvasási kerete miatt)
    function allFriends(l) {
      return l.size() <= 8
        && (l.size() < 1 || friendOrMe(l[0])) && (l.size() < 2 || friendOrMe(l[1])) && (l.size() < 3 || friendOrMe(l[2]))
        && (l.size() < 4 || friendOrMe(l[3])) && (l.size() < 5 || friendOrMe(l[4])) && (l.size() < 6 || friendOrMe(l[5]))
        && (l.size() < 7 || friendOrMe(l[6])) && (l.size() < 8 || friendOrMe(l[7]));
    }
    // ---- többjátékos szobák (js/net.js): WebRTC-bemutatkozás. A meccs alatt nem írunk ide. ----
    // vis: akik a szobát a listájukban látják és beléphetnek (a gazda barátai / meghívottjai) – a belépésnél a barátságot külön is ellenőrizzük
    function roomOk(d) {
      return d.keys().hasOnly(['host', 'hostName', 'game', 'mode', 'map', 'max', 'open', 'state', 'members', 'vis', 'createdAt', 'updatedAt'])
        && d.host is string && d.hostName is string && d.hostName.size() <= 40
        && d.game in ['vizagyuio', 'drift'] && d.mode is string && d.mode.size() <= 16 && d.map is string && d.map.size() <= 16
        && d.max is int && d.max >= 2 && d.max <= 8 && d.open is bool && d.state in ['lobby', 'play']
        && d.members is list && d.members.size() >= 1 && d.members.size() <= d.max
        && d.vis is list && d.vis.size() <= 100 && d.updatedAt == request.time;
    }
    match /rooms/{rid} {
      allow get: if signedIn();   // a szobaazonosító maga a meghívó; a dokumentumban csak azonosítók és beállítások vannak
      allow list: if signedIn() && (request.auth.uid in resource.data.vis || request.auth.uid in resource.data.members);
      allow create: if active() && roomOk(request.resource.data)
        && request.resource.data.host == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.state == 'lobby' && request.resource.data.createdAt == request.time;
      allow update: if active() && roomOk(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.game == resource.data.game
        && (
          // a gazda: beállítások, láthatóság, állapot; tagot csak kivehet (és ki is léphet)
          (resource.data.host == request.auth.uid && request.resource.data.host == resource.data.host
            && resource.data.members.hasAll(request.resource.data.members))
          // belépés: csak a gazda barátja, ha szerepel a vis listán és van hely
          || (changed().hasOnly(['members', 'updatedAt']) && !(request.auth.uid in resource.data.members)
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.auth.uid in resource.data.vis && areFriends(request.auth.uid, resource.data.host))
          // kilépés
          || (changed().hasOnly(['members', 'updatedAt']) && request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
          // gazdaváltás: egy bent lévő tag veszi át a kiesett gazda helyét
          || (changed().hasOnly(['host', 'hostName', 'updatedAt']) && request.auth.uid in resource.data.members
            && request.resource.data.host == request.auth.uid)
        );
      // a gazda törölheti; elárvult (2 óránál régebbi) szobát bármelyik tagja
      allow delete: if signedIn() && (resource.data.host == request.auth.uid
        || (request.auth.uid in resource.data.members && resource.data.updatedAt < request.time - duration.value(2, 'h')));
      match /sig/{sid} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'to', 'k', 'n', 'd', 'name', 'at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.k in ['offer', 'answer'] && request.resource.data.d is string && request.resource.data.d.size() <= 12000
          && request.auth.uid in get(/databases/$(db)/documents/rooms/$(rid)).data.members
          && request.resource.data.to in get(/databases/$(db)/documents/rooms/$(rid)).data.members;
        allow read, delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }
    // ---- többjátékos statisztika: mindenki a sajátját növeli, meccsenként korlátozott lépésekben, legfeljebb 45 mp-enként ----
    function mpStep(k, mx) { return request.resource.data.get(k, 0) is int && request.resource.data.get(k, 0) >= resource.data.get(k, 0) && request.resource.data.get(k, 0) - resource.data.get(k, 0) <= mx; }
    function mpNew(k, mx) { return request.resource.data.get(k, 0) is int && request.resource.data.get(k, 0) >= 0 && request.resource.data.get(k, 0) <= mx; }
    match /mpstats/{uid} {
      allow read: if signedIn();
      allow create: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'kos', 'boss', 'm_volgy', 'm_aszaly', 'm_gyar', 'm_atemelo', 'updatedAt'])
        && request.resource.data.games == 1 && mpNew('wins', 1) && mpNew('kos', 40) && mpNew('boss', 1)
        && mpNew('m_volgy', 1) && mpNew('m_aszaly', 1) && mpNew('m_gyar', 1) && mpNew('m_atemelo', 1)
        && request.resource.data.updatedAt == request.time;
      allow update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'kos', 'boss', 'm_volgy', 'm_aszaly', 'm_gyar', 'm_atemelo', 'updatedAt'])
        && request.resource.data.games == resource.data.games + 1 && mpStep('wins', 1) && mpStep('kos', 40) && mpStep('boss', 1)
        && mpStep('m_volgy', 1) && mpStep('m_aszaly', 1) && mpStep('m_gyar', 1) && mpStep('m_atemelo', 1)
        && request.resource.data.updatedAt == request.time && resource.data.updatedAt < request.time - duration.value(45, 's');
    }
    match /friends/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if active()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && fid == pairId(request.auth.uid, request.resource.data.to)
        && request.resource.data.users == (request.auth.uid < request.resource.data.to
              ? [request.auth.uid, request.resource.data.to] : [request.resource.data.to, request.auth.uid])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(db)/documents/users/$(request.resource.data.to))
        && get(/databases/$(db)/documents/users/$(request.resource.data.to)).data.get('banned', false) != true;
      allow update: if active() && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ---------- privát üzenetek és csoportok ----------
    // Privát (dm) beszélgetést csak barátok indíthatnak és csak barátok írhatnak bele;
    // csoportba csak a meghívó barátai kerülhetnek.
    match /conversations/{cid} {
      function dmOk(d) { return d.type != 'dm' || areFriends(d.members[0], d.members[1]); }
      allow read: if active() && request.auth.uid in resource.data.members;

      allow create: if canPost()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50
        && request.resource.data.type in ['dm', 'group']
        && ((request.resource.data.type == 'group' && allFriends(request.resource.data.members.removeAll([request.auth.uid])))
            || (request.resource.data.members.size() == 2
                && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                && areFriends(request.resource.data.members[0], request.resource.data.members[1])));

      allow update: if active() && request.auth.uid in resource.data.members && (
        changed().hasOnly(['reads'])
        || (dmOk(resource.data) && changed().hasOnly(['lastMessage', 'updatedAt', 'reads']))
        || (resource.data.type == 'group'
          && changed().hasOnly(['name', 'members', 'updatedAt', 'lastMessage', 'reads'])
          && request.resource.data.members.size() <= 50
          && ((request.resource.data.members.hasAll(resource.data.members)                        // tag hozzáadása (csak barát)
                && allFriends(request.resource.data.members.removeAll(resource.data.members)))
              || (!(request.auth.uid in request.resource.data.members)                            // kilépés
                  && resource.data.members.hasAll(request.resource.data.members)
                  && request.resource.data.members.size() == resource.data.members.size() - 1)
              || (resource.data.owner == request.auth.uid                                         // tulaj eltávolít
                  && resource.data.members.hasAll(request.resource.data.members))))
      );

      allow delete: if active() && resource.data.get('owner', '') == request.auth.uid;

      match /messages/{mid} {
        function members() { return getAfter(/databases/$(db)/documents/conversations/$(cid)).data.members; }
        allow read: if active() && request.auth.uid in get(/databases/$(db)/documents/conversations/$(cid)).data.members;
        allow create: if canPost() && request.auth.uid in members() && validMsg()
          && dmOk(getAfter(/databases/$(db)/documents/conversations/$(cid)).data);
        allow update: if request.auth.uid in members() && msgUpdate();
        allow delete: if active() && resource.data.uid == request.auth.uid;
      }
    }

    // ---------- filmek ----------
    // A film adatai (cím, poszter, állapot) nyilvánosak – a főoldal ezekből mutatja az előzetest.
    match /videos/{id} {
      allow read: if true;
      allow write: if perm('publishMedia');

      // hozzászólások a filmekhez (a vendég olvashatja, de nem írhat)
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if canPost() && validMsg();
        allow update: if msgUpdate();
        allow delete: if (active() && resource.data.uid == request.auth.uid) || (perm('deleteMessages') && resource.data.uid != ownerId());
      }

      // csillagos értékelés: dokumentum-azonosító = a tag uid-ja, így mindenki csak egyszer értékelhet
      match /ratings/{rid} {
        allow read: if signedIn();
        allow create, update: if active() && rid == request.auth.uid
          && request.resource.data.keys().hasOnly(['stars', 'at'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.at == request.time;
        allow delete: if (active() && rid == request.auth.uid) || (perm('deleteMessages') && rid != ownerId());
      }
    }
    // Zenék: belépett tagok és vendégek hallgathatják, csak admin kezeli.
    match /music/{id} {
      allow read: if signedIn();
      allow write: if perm('publishMedia');
    }
    // A videó forrása csak belépett tagoknak és vendégeknek látszik (a lejátszóhoz kell).
    match /videoSources/{id} {
      allow read: if perm('publishMedia') || signedIn();
      allow write: if perm('publishMedia');
    }
  }
}
