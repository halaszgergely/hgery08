rules_version = '2';

// HGWS – Firestore biztonsági szabályok
// Másold be: Firebase Console → Firestore Database → Rules → Publish
//
// Rangok (users/{uid}.role) – a jogokat a „roles” gyűjtemény adja, ha nincs dokumentum, az alábbi alapértékek:
//   owner       – 👑 TULAJ: be van égetve (ownerId), mindent tud, őt senki nem tilthatja, némíthatja, nem veheti el a rangját
//   admin       – minden jog; rangot csak kérelmezhet (a tulaj hagyja jóvá), admint csak a tulaj adhat
//   szerkeszto  – moderátori jogok + film/zene beküldése (admin hagyja jóvá)
//   moderator   – némítás, tiltás (alacsonyabb rangúaknál), üzenettörlés, tagek, ötletek megválaszolása
//   user        – csevegés, filmnézés, értékelés, ötletek beküldése
//   vendég      – Firebase névtelen (Anonymous) belépés: csak filmnézés, olvasás
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function profilePath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function active() { return verified() && hasProfile() && me().get('banned', false) != true; }
    function notMuted() { return me().get('mutedUntil', null) == null || me().mutedUntil < request.time; }
    function canPost() { return active() && notMuted(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- tulaj és jogosultságok ----------
    function ownerId() { return 'bzKz3gAS55hLmf3pru7Ljw0NETN2'; }
    function isOwner() { return signedIn() && request.auth.uid == ownerId(); }
    function defaultPerms() {
      return {
        'admin': {'moderate': true, 'deleteMessages': true, 'announce': true, 'manageTags': true, 'tickets': true,
                  'submitMedia': true, 'publishMedia': true, 'manageChannels': true, 'assignRoles': true},
        'szerkeszto': {'moderate': true, 'deleteMessages': true, 'announce': true, 'manageTags': true, 'tickets': true, 'submitMedia': true},
        'moderator': {'moderate': true, 'deleteMessages': true, 'announce': true, 'manageTags': true, 'tickets': true},
        'user': {}
      };
    }
    function defaultRanks() { return {'owner': 100, 'admin': 80, 'szerkeszto': 60, 'moderator': 40, 'user': 10}; }
    function rolePath(r) { return /databases/$(db)/documents/roles/$(r); }
    function roleExists(r) { return r in defaultRanks() || exists(rolePath(r)); }
    function rankOf(r) { return r != 'owner' && exists(rolePath(r)) ? get(rolePath(r)).data.rank : defaultRanks().get(r, 0); }
    function myRole() { return me().get('role', 'user'); }
    function myRank() { return isOwner() ? 1000 : rankOf(myRole()); }
    function userRank(uid) {
      return uid == ownerId() ? 1000 : rankOf(get(/databases/$(db)/documents/users/$(uid)).data.get('role', 'user'));
    }
    function perm(p) {
      return isOwner() || (active() && (exists(rolePath(myRole()))
        ? get(rolePath(myRole())).data.get('perms', {}).get(p, false) == true
        : defaultPerms().get(myRole(), {}).get(p, false) == true));
    }

    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 32; }

    // Foglalt nevek: a hgery / hgery08 / Halász Gergely bármilyen változatát csak a tulajdonos használhatja
    function reservedName(n) {
      let s = n.lower();
      let A = '[aáà4@]';
      let E = '[eéè3]';
      let sep = '[^a-z0-9áéíóöőúüű]*';
      let hgery = '.*h' + sep + '[g69]' + sep + E + sep + 'r' + sep + '[yií1].*';
      let halasz = '.*h' + sep + A + sep + 'l' + sep + A + sep + 's' + sep + 'z.*';
      let gergely = '.*[g69]' + sep + E + sep + 'r' + sep + '[g69]' + sep + E + sep + 'l' + sep + '[yií1].*';
      return s.matches(hgery)
        || (s.matches(halasz) && s.matches(gergely))
        || s.matches('(.*[^a-z]|)h[^a-z]+' + '[g69]' + sep + E + sep + 'r' + sep + '[g69]' + sep + E + sep + 'l' + sep + '[yií1].*')
        || s.matches('.*h' + sep + A + sep + 'l' + sep + A + sep + 's' + sep + 'z[^a-z]+[g69]([^a-z].*|)');
    }
    // NEVSZURO-START – generálva a js/nevszuro.js listáiból (node tools/nevszuro.mjs), kézzel ne írd át
    function nameNorm(n) {
      return n.lower().replace('[áàâä]', 'a').replace('[éèêë]', 'e').replace('[íìîï]', 'i').replace('[óòôöő]', 'o').replace('[úùûüű]', 'u')
        .replace('[çčć]', 'c').replace('ñ', 'n').replace('š', 's').replace('ž', 'z').replace('ř', 'r').replace('ý', 'y')
        .replace('[4@]', 'a').replace('3', 'e').replace('[1!|]', 'i').replace('0', 'o').replace('[5$]', 's').replace('7', 't')
        .replace('q', 'k').replace('ph', 'f').replace('cz', 'c').replace('w', 'v')
        .replace('[^a-z]+', ' ').trim();
    }
    function badName(n) {
      let sp = ' ' + nameNorm(n).replace('(scunthorpe|pornoapati|ciganyzene|kurvenbau|retardalo|penistone|agrippina|therapist|shiitake|cocktail|assassin|pinatubo|pussycat|buzinkai|shitake|hancock|peacock|cockpit|dickens|dickson|passion|compass|spinach|basszus|cigaret|arsenal|szopran|fosszil|foszfor|puttony|sussex|seggio|titsch|putnok|essex|sukar)', '_') + ' ';
      return !n.matches("^[A-Za-z0-9 .'_\\x{00C0}-\\x{024F}\\x{1F000}-\\x{1FAFF}\\x{2190}-\\x{21FF}\\x{2300}-\\x{23FF}\\x{2460}-\\x{27BF}\\x{2900}-\\x{297F}\\x{2B00}-\\x{2BFF}\\x{3030}\\x{303D}\\x{2122}\\x{2139}\\x{200D}\\x{FE0F}\\x{20E3}\\x{E0020}-\\x{E007F}-]+$")
        || sp.replace(' ', '').matches('.*(k+u+r+v+a+|k+r+v+a+|k+u+r+v+a+n+y+|f+a+s+z+|p+i+c+s+a+|p+u+n+c+i+|p+i+n+a+s+|p+i+n+a+j+|p+i+n+a+f+e+j+|p+i+n+a+n+y+a+l+o+|g+e+c+i+|b+u+z+i+|b+u+z+e+r+a+n+|k+o+c+s+o+g+|s+e+g+g+|b+a+z+m+e+g+|b+a+z+d+m+e+g+|b+a+z+z+e+g+|b+a+s+z+d+|b+a+s+z+o+|b+a+s+z+n+|b+a+s+z+t+|b+a+s+z+i+|b+a+s+z+h+|b+a+s+z+a+s+|b+a+s+s+z+a+m+|b+a+s+s+z+o+n+|b+a+s+s+z+a+d+|b+a+s+z+k+i+|k+i+b+a+s+z+|e+l+b+a+s+z+|m+e+g+b+a+s+z+|l+e+b+a+s+z+|s+z+e+t+b+a+s+z+|f+e+l+b+a+s+z+|s+z+a+r+h+a+z+i+|s+z+a+r+f+e+j+|s+z+a+r+z+s+a+k+|s+z+a+r+c+s+i+m+b+o+k+|k+u+t+y+a+s+z+a+r+|f+o+s+t+a+l+i+c+s+k+a+|f+o+s+f+e+j+|a+n+y+a+d+a+t+|a+n+y+a+d+b+a+|k+u+r+v+a+a+n+y+a+d+|r+i+b+a+n+c+|l+o+t+y+o+|r+i+n+g+y+o+|s+z+a+j+h+a+|c+a+f+k+a+|r+o+h+a+d+e+k+|c+s+i+c+s+k+a+|s+z+o+p+o+|s+z+o+p+j+|s+z+o+p+d+|s+z+o+p+a+s+|s+z+o+p+a+t+|l+e+s+z+o+p+|p+o+c+s+f+e+j+|f+u+t+y+i+|c+i+g+a+n+y+|n+e+g+e+r+|n+i+g+g+e+r+|n+i+g+g+a+|n+i+g+g+|z+s+i+d+o+z+o+|f+a+s+z+o+m+|m+e+g+d+u+g+|m+e+g+[dk]+e+f+|k+e+f+e+l+|k+u+r+o+l+|g+e+n+n+y+e+s+|t+o+k+f+e+j+|h+e+r+e+g+o+l+y+o+|p+e+d+o+f+i+l+|h+i+t+l+e+r+|s+t+r+i+c+i+|p+r+o+s+t+i+|m+a+s+z+t+u+r+b+|r+e+j+s+z+o+l+|s+e+g+g+f+e+j+|s+e+g+g+n+y+a+l+o+|s+e+g+g+l+y+u+k+|h+u+g+y+o+s+|r+e+t+a+r+d+a+l+t+|b+u+z+i+z+s+|p+i+n+a+s+z+o+r+|f+u+c+k+|f+v+c+k+|s+h+i+t+|b+i+t+c+h+|b+i+a+t+c+h+|c+u+n+t+|v+h+o+r+e+|s+l+u+t+|p+u+s+s+y+|a+s+s+h+o+l+e+|a+r+s+e+h+o+l+e+|d+i+c+k+h+e+a+d+|c+o+c+k+s+u+c+k+|f+a+g+g+o+t+|m+o+t+h+e+r+f+|p+o+r+n+|p+e+n+i+s+|v+a+g+i+n+a+|b+o+o+b+|t+i+t+t+i+e+s+|v+a+n+k+|b+a+s+t+a+r+d+|j+e+r+k+o+f+f+|b+l+o+v+j+o+b+|h+a+n+d+j+o+b+|c+u+m+s+h+o+t+|j+i+z+z+|d+i+l+d+o+|r+a+p+i+s+t+|m+o+l+e+s+t+|h+e+n+t+a+i+|p+e+d+o+p+h+i+l+e+|k+i+l+l+y+o+u+r+s+e+l+f+|s+c+h+l+a+m+p+e+|s+c+h+e+i+s+s+e+|a+r+s+c+h+l+o+c+h+|f+o+t+z+e+|h+u+r+e+n+s+o+h+n+|v+i+c+h+s+e+r+|p+e+n+d+e+j+o+|b+l+y+a+t+|c+y+k+a+|p+i+z+d+a+|j+e+b+a+c+|s+a+l+o+p+e+|p+u+t+a+i+n+).*')
        || sp.matches('.* (p+i+n+a+|p+o+c+s+|f+o+s+|k+u+k+i+|a+n+y+a+d+|c+i+g+o+|c+s+o+c+s+|c+i+c+i+|d+i+d+i+|p+e+d+o+|n+a+c+i+|n+y+i+l+a+s+|s+z+u+k+a+|h+u+g+y+|o+n+d+o+|s+p+e+r+m+a+|s+z+e+x+|p+o+r+n+o+|r+e+t+a+r+d+|k+r+e+t+e+n+|k+u+r+a+f+i+|f+a+t+t+y+u+|g+e+n+y+|f+u+k+|f+c+k+|c+o+c+k+|c+u+m+|a+n+a+l+|a+n+u+s+|r+a+p+e+|s+e+x+|s+e+x+y+|n+u+d+e+|n+a+k+e+d+|h+o+r+n+y+|m+i+l+f+|t+i+t+s+|t+v+a+t+|p+r+i+c+k+|n+a+z+i+|k+k+k+|k+y+s+|n+e+g+r+o+|k+i+k+e+|c+h+i+n+k+|s+p+i+c+|t+r+a+n+n+y+|f+a+g+|s+u+k+a+|p+u+t+a+|c+h+u+j+|m+e+r+d+e+|m+i+e+r+d+a+)(s|k|ok|ek|ak)? .*');
    }
    // NEVSZURO-END
    // a név akkor jó, ha nem foglalt – vagy ha a tulaj fiókjáról van szó
    function nameAllowed(uid, n) { return (!reservedName(n) || uid == ownerId()) && !badName(n); }

    // HGWS matricák és saját emojik – csak ezek az azonosítók küldhetők (img/stickers/hgws/stickers.json)
    function stickerIds() { return ['szilard_nevet', 'szilard_duhos', 'szilard_azott', 'szilard_megszaritalak', 'szilard_laza', 'locsolofej_ragyog', 'locsolofej_megvan', 'locsolofej_sziv', 'csepp_boldog', 'csepp_sir', 'csepp_szivszem', 'csepp_nevet', 'csepp_gondolkodik', 'csepp_alszik', 'csepp_plusz1', 'novenyke', 'kaktusz_rip', 'hgws_approved', 'szlogen', 'locsolj', 'gg']; }
    // reakcióként csak a választó emojijai és a saját emojik kódjai használhatók (js/ui.js EMOJIS + stickers.json)
    function reactionKeys() { return ['👍', '❤️', '😂', '🔥', '💧', '😮', '😢', '😡', '🎉', '👏', '🙏', '💯', '😎', '🤔', '👀', '🤣', '😍', '🥲', '😅', '🙃', '🤝', '💪', '🚿', '🌱', '🌊', '🏆', '⭐', '✅', '❌', '🍿', '🎬', '🎮',
      ':szilard:', ':szilard_duhos:', ':szilard_azott:', ':locsolofej:', ':csepp:', ':csepp_sir:', ':csepp_szivszem:', ':csepp_nevet:', ':hgws:', ':approved:', ':kaktusz:', ':novenyke:']; }

    // új üzenet formai ellenőrzése
    function validMsg() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.text is string && d.text.size() <= 4000
        && d.keys().hasOnly(['uid', 'text', 'createdAt', 'film', 'track', 'replyTo', 'reactions', 'poll', 'sticker'])
        && (d.text.size() > 0 || d.get('film', null) is string || d.get('track', null) is string || 'sticker' in d)
        && (!('poll' in d) || (d.poll.q is string && d.poll.q.size() <= 200 && d.poll.opts is list && d.poll.opts.size() >= 2 && d.poll.opts.size() <= 6))
        // matrica: külön üzenettípus, szöveg és melléklet nélkül, csak ismert azonosítóval
        && (!('sticker' in d) || (d.sticker is string && d.sticker in stickerIds() && d.text == ''
            && !('poll' in d) && !('film' in d) && !('track' in d)));
    }
    // saját üzenet szerkesztése vagy bárki reagál
    function msgUpdate() {
      return (canPost() && resource.data.uid == request.auth.uid && !('sticker' in resource.data)
              && changed().hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string && request.resource.data.text.size() <= 4000)
          || (active() && changed().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly(reactionKeys()))
          // szavazás: mindenki csak a saját szavazatát állíthatja
          || (canPost() && 'poll' in resource.data && changed().hasOnly(['pv'])
            && request.resource.data.pv.diff(resource.data.get('pv', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.pv)
              || (request.resource.data.pv[request.auth.uid] is int && request.resource.data.pv[request.auth.uid] >= 0
                && request.resource.data.pv[request.auth.uid] < resource.data.poll.opts.size())));
    }

    // ---------- vendégek jelenléte (Online lista) – a vendég csak a saját becenevét és idejét írhatja ----------
    // ---------- gyanús eredmények (pl. időmanipuláció): bárki beküldheti a sajátját, csak moderátor látja és törli ----------
    match /suspects/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'guest', 'game', 'score', 'why', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.guest is bool
        && request.resource.data.game is string && request.resource.data.game.size() <= 30 && request.resource.data.score is number
        && request.resource.data.why is string && request.resource.data.why.size() <= 20 && request.resource.data.at == request.time;
      allow read, delete: if perm('moderate');
    }

    match /guests/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['nick', 'lastSeen'])
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 20 && request.resource.data.nick.matches('^[^<>&"]+$')
        && request.resource.data.lastSeen == request.time;
      allow delete: if request.auth.uid == uid || perm('publishMedia') || perm('moderate');
    }

    // ---------- vendégfiók-összevonás jelzése: a moderátor írja, a vendég (és a moderátorok) olvassák ----------
    match /merges/{gid} {
      allow read: if signedIn() && (request.auth.uid == gid || perm('moderate'));
      allow create, update: if perm('moderate') && request.resource.data.keys().hasOnly(['into', 'by', 'at'])
        && request.resource.data.into is string && request.resource.data.into != gid && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
    }

    // ---------- vendégnevek egyedisége: guestnames/{kisbetűs név} = { uid, nick, at, lock } ----------
    // A vendég a saját nevét foglalja le (más friss foglalását nem írhatja felül, 60 napnál régebbit átvehet);
    // a moderátor bármelyik vendégnek adhat nevet (lock: true) – azt a vendég már nem módosíthatja.
    match /guestnames/{key} {
      allow read: if signedIn();
      function gnOk() { return request.resource.data.keys().hasOnly(['uid', 'nick', 'at', 'lock']) && request.resource.data.uid is string
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 20 && request.resource.data.nick.matches('^[^<>&"/]+$')
        && request.resource.data.nick.lower() == key && request.resource.data.at == request.time; }
      function gnMine() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.data.uid == request.auth.uid && request.resource.data.get('lock', false) == false; }
      allow create: if gnOk() && (gnMine() || perm('moderate'));
      allow update: if gnOk() && (perm('moderate') || (gnMine() && resource.data.get('lock', false) == false
        && (resource.data.uid == request.auth.uid || resource.data.at < request.time - duration.value(1440, 'h'))));
      allow delete: if perm('moderate') || (signedIn() && resource.data.uid == request.auth.uid && resource.data.get('lock', false) == false);
    }

    // ---------- e-mail címek: CSAK az adminok és a tulaj olvashatják ----------
    // A tag kizárólag a saját, a belépési tokenjében szereplő címét írhatja be – más nevében vagy hamis címmel nem.
    match /emails/{uid} {
      allow get: if isOwner() || perm('publishMedia') || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner() || perm('publishMedia');
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- felhasználók ----------
    match /users/{uid} {
      // a nevek a hozzászólásokhoz kellenek, ezért a vendégek is olvashatják
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'color', 'role', 'banned', 'createdAt', 'lastSeen', 'photoURL', 'bio'])
        && (request.resource.data.role == 'user' || (uid == ownerId() && request.resource.data.role == 'owner'))
        && request.resource.data.banned == false
        && validName(request.resource.data.name)
        && nameAllowed(uid, request.resource.data.name);

      // A TULAJ profilját csak ő maga módosíthatja – senki nem tilthatja, némíthatja, nem veheti el a rangját.
      allow update: if (uid == ownerId() && isOwner()
          && changed().hasOnly(['name', 'nameLower', 'bio', 'color', 'lastSeen', 'photoURL', 'role', 'tags', 'banned', 'mutedUntil'])
          && (!('role' in changed()) || request.resource.data.role == 'owner') && request.resource.data.get('banned', false) == false
          && validName(request.resource.data.name)
          && request.resource.data.get('bio', '').size() <= 300)
        || (uid != ownerId() && (
          // saját profil
          (signedIn() && request.auth.uid == uid
            && changed().hasOnly(['name', 'nameLower', 'bio', 'color', 'lastSeen', 'photoURL'])
            && validName(request.resource.data.name)
            && (!('name' in changed()) || nameAllowed(uid, request.resource.data.name))
            && request.resource.data.get('bio', '').size() <= 300)
          // rangot közvetlenül CSAK a tulaj adhat (a többiek kérelmet küldenek: roleRequests)
          || (isOwner() && request.resource.data.get('role', 'user') != 'owner' && roleExists(request.resource.data.get('role', 'user'))
            && (!('name' in changed()) || (validName(request.resource.data.name) && nameAllowed(uid, request.resource.data.name))))
          // moderálás: némítás, tiltás, átnevezés – csak nála alacsonyabb rangúnál
          || (perm('moderate') && request.auth.uid != uid && rankOf(resource.data.get('role', 'user')) < myRank()
            && changed().hasOnly(['banned', 'mutedUntil', 'name', 'nameLower'])
            && (!('name' in changed()) || (validName(request.resource.data.name) && nameAllowed(uid, request.resource.data.name))))
          // tagek kiosztása
          || (perm('manageTags') && changed().hasOnly(['tags'])
            && request.resource.data.tags is list && request.resource.data.tags.size() <= 10)
        ));

      allow delete: if isOwner() && uid != ownerId();

      // saját olvasottsági jelölők stb.
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // értesítések: a cselekvő tag írja a címzettnek, csak a címzett olvashatja / jelölheti olvasottnak / törölheti
      match /notifs/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && changed().hasOnly(['read']);
        allow create: if (active() || (signedIn() && request.auth.uid == uid))
          && request.resource.data.keys().hasOnly(['type', 'text', 'link', 'by', 'at', 'read'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && request.resource.data.link is string && request.resource.data.link.size() <= 200
          && request.resource.data.type in ['mention', 'idea', 'approve', 'reject', 'role', 'tag', 'premiere', 'party', 'vote', 'badge', 'friend', 'game', 'birodalom']
          && (request.resource.data.type != 'badge' || request.auth.uid == uid);   // kitüntetésről csak saját magának írhat
      }
    }

    // ---------- rangok (a tulaj szerkeszti) ----------
    match /roles/{rid} {
      allow read: if signedIn();
      allow create, update: if isOwner() && rid != 'owner'
        && request.resource.data.keys().hasOnly(['name', 'color', 'rank', 'perms'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.rank is int && request.resource.data.rank >= 1 && request.resource.data.rank <= 99
        && request.resource.data.perms is map;
      allow delete: if isOwner();
    }

    // ---------- rangkérelmek: admin kéri, a tulaj hagyja jóvá ----------
    match /roleRequests/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if perm('assignRoles')
        && request.resource.data.keys().hasOnly(['target', 'role', 'prev', 'by', 'at', 'status'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time
        && request.resource.data.role != 'owner' && request.resource.data.role != 'admin'
        && roleExists(request.resource.data.role)
        && rankOf(request.resource.data.role) < myRank()
        && request.resource.data.target != ownerId() && request.resource.data.target != request.auth.uid
        && userRank(request.resource.data.target) < myRank();
      allow update: if isOwner() && changed().hasOnly(['status', 'reviewedAt']);
      allow delete: if isOwner() || (signedIn() && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }

    // ---------- film- és zenebeküldések: szerkesztő küldi, admin hagyja jóvá ----------
    match /submissions/{id} {
      allow read: if perm('publishMedia') || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if perm('submitMedia')
        && request.resource.data.keys().hasOnly(['type', 'action', 'targetId', 'title', 'data', 'src', 'by', 'at', 'status'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time
        && request.resource.data.type in ['film', 'music']
        && request.resource.data.action in ['create', 'update', 'delete'];
      allow update: if perm('publishMedia') && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'note'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if perm('publishMedia') || (signedIn() && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }

    // ---------- ötletek / ticketek: tag beküldi, moderátortól felfelé válaszolnak ----------
    match /ideas/{id} {
      allow read: if perm('tickets') || (signedIn() && resource.data.uid == request.auth.uid) || (active() && resource.data.get('public', false) == true);
      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'text', 'category', 'status', 'replies', 'public', 'votes', 'createdAt', 'updatedAt'])
        && request.resource.data.get('public', false) is bool && request.resource.data.get('votes', []) == []
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'nyitott' && request.resource.data.replies == 0
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.category in ['otlet', 'hiba', 'kerdes', 'egyeb']
        && request.resource.data.createdAt == request.time;
      allow update: if (perm('tickets')
          && changed().hasOnly(['status', 'updatedAt', 'replies', 'lastReplyAt', 'lastReplyBy', 'public'])
          && request.resource.data.status in ['nyitott', 'folyamatban', 'kesz', 'elutasitva'])
        || (canPost() && resource.data.uid == request.auth.uid
          && changed().hasOnly(['updatedAt', 'replies', 'lastReplyAt', 'lastReplyBy'])
          && request.resource.data.replies == resource.data.replies + 1)
        // szavazás (👍) a nyilvános ötletekre: mindenki csak a saját szavazatát teszi be / veszi ki
        || (active() && resource.data.get('public', false) == true && changed().hasOnly(['votes'])
          && request.resource.data.votes is list && request.resource.data.votes.size() <= 5000
          && request.resource.data.votes.toSet().difference(resource.data.get('votes', []).toSet())
              .union(resource.data.get('votes', []).toSet().difference(request.resource.data.votes.toSet())).hasOnly([request.auth.uid]));
      allow delete: if perm('tickets') || (signedIn() && resource.data.uid == request.auth.uid);

      match /replies/{rid} {
        function ticket() { return get(/databases/$(db)/documents/ideas/$(id)).data; }
        allow read: if perm('tickets') || (signedIn() && ticket().uid == request.auth.uid) || (active() && ticket().get('public', false) == true);
        allow create: if canPost() && (perm('tickets') || ticket().uid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if perm('tickets');
      }
    }

    // tagek: szöveg + szín, a moderátorok és adminok kezelik, mindenki (vendég is) látja
    match /tags/{tid} {
      allow read: if signedIn();
      allow create, update: if perm('manageTags')
        && request.resource.data.keys().hasOnly(['name', 'color', 'order', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
      allow delete: if perm('manageTags');
    }

    // ---------- napló (audit log): bárki írhat saját nevében, csak a tulaj és az adminok olvashatják, senki nem törölheti ----------
    match /audit/{id} {
      allow read: if isOwner() || perm('assignRoles');
      allow create: if active()
        && request.resource.data.keys().hasOnly(['by', 'action', 'target', 'detail', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.target is string && request.resource.data.target.size() <= 120
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow update, delete: if false;
    }

    // ---------- megtekintések: filmenként egy számláló, csak eggyel nőhet ----------
    match /views/{vid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && changed().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // ---------- Arcade népszerűség: játékonkénti indításszám, csak eggyel nőhet ----------
    // ---------- ki mit játszik éppen az Arcade-ban: mindenki csak a saját jelenlétét írja (percenként), bárki olvashatja ----------
    // ki játszik most: 5 perces vödrök (playnow/{vödör} = { u: { uid: játék } }) – mindenki csak a saját kulcsát írhatja, csak a jelenlegi vödör körül
    match /playnow/{b} {
      allow read: if signedIn();
      allow create, update: if signedIn() && b.matches('^[0-9]{6,9}$')
        && int(b) >= request.time.toMillis() / 300000 - 2 && int(b) <= request.time.toMillis() / 300000 + 1
        && request.resource.data.keys().hasOnly(['u'])
        && (resource == null ? request.resource.data.u.keys().hasOnly([request.auth.uid]) : request.resource.data.u.diff(resource.data.u).affectedKeys().hasOnly([request.auth.uid]))
        && (!(request.auth.uid in request.resource.data.u)
          || (request.resource.data.u[request.auth.uid] is string && request.resource.data.u[request.auth.uid].matches('^[a-z0-9]{2,24}$')));
    }
    match /playing/{uid} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['g', 'at'])
        && request.resource.data.g is string && request.resource.data.g.matches('^[a-z0-9]{2,24}$')
        && request.resource.data.at == request.time;
    }
    match /plays/{gid} {
      allow read: if true;
      allow create: if signedIn() && gid.matches('^[a-z0-9]{2,24}$') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && changed().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // ---------- Arcade ranglista + Drift: vendégek (névtelen belépés) is felkerülhetnek ----------
    // Nekik kötelező a „nick” (becenév) mező, a regisztráltaknál a profilnév látszik
    function isGuest() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function okNick(n) { return n is string && n.size() >= 2 && n.size() <= 20 && n.matches('^[^<>&"]+$') && !reservedName(n) && !badName(n); }
    function lbWriter(uid, extra) {
      return request.auth.uid == uid && (
        (active() && request.resource.data.keys().hasOnly(extra))
        || (isGuest() && request.resource.data.keys().hasOnly(extra.concat(['nick'])) && okNick(request.resource.data.get('nick', null))));
    }
    function nickChanged() { return isGuest() && request.resource.data.nick != resource.data.get('nick', ''); }

    // ---------- Drift Király: pályánkénti legjobb kör (szellemautó) és verseny-idő – csak javulhat ----------
    match /ghosts/{track}/runs/{uid} {
      allow read: if signedIn();
      allow create, update: if lbWriter(uid, ['ms', 'car', 'path', 'rms', 'at'])
        && request.resource.data.ms is int && request.resource.data.ms > 5000 && request.resource.data.ms <= 3600000
        && request.resource.data.rms is int && request.resource.data.rms > 10000 && request.resource.data.rms <= 3600000
        && request.resource.data.car is string && request.resource.data.car.size() < 20
        && request.resource.data.path is string && request.resource.data.path.size() < 60000
        && request.resource.data.at == request.time
        && (resource == null || (request.resource.data.ms <= resource.data.ms && request.resource.data.rms <= resource.data.rms
            && (request.resource.data.ms < resource.data.ms || request.resource.data.rms < resource.data.rms || nickChanged())));
      // vendégfiók összevonása: a moderátor a regisztrált fiók idejét csak javíthatja, a vendégét törölheti
      allow create, update: if perm('moderate') && request.resource.data.keys().hasOnly(['ms', 'car', 'path', 'rms', 'at', 'merged']) && request.resource.data.merged is string
        && request.resource.data.ms is int && request.resource.data.ms > 5000 && request.resource.data.rms is int && request.resource.data.rms > 10000
        && request.resource.data.car is string && request.resource.data.car.size() < 20 && request.resource.data.path is string && request.resource.data.path.size() < 60000 && request.resource.data.at == request.time
        && (resource == null || (!('nick' in resource.data) && request.resource.data.ms <= resource.data.ms && request.resource.data.rms <= resource.data.rms));
      allow delete: if perm('publishMedia') || (perm('moderate') && 'nick' in resource.data);
    }

    // ---------- Arcade ranglista: mindenki csak a saját rekordját írhatja, és csak felfelé ----------
    // wins: hányszor érte el a csúcsot (Víztorony) – egyszerre csak eggyel nőhet
    // csalásgyanú: a moderátor „ellenőrzésre vár” jelölést tesz egy játékos eredményére (lbflags/{játék}__{uid});
    // az eredmény a ranglistán marad, de a végére kerül „Csalás észlelve” felirattal
    match /lbflags/{id} {
      allow read: if signedIn();
      allow create: if perm('moderate') && request.resource.data.keys().hasOnly(['game', 'uid', 'by', 'at'])
        && request.resource.data.game is string && request.resource.data.uid is string
        && id == request.resource.data.game + '__' + request.resource.data.uid
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if perm('moderate');
    }
    match /leaderboards/{lb}/scores/{uid} {
      allow read: if signedIn();
      allow create: if lbWriter(uid, ['best', 'at', 'wins'])
        && request.resource.data.best is number && request.resource.data.best > 0 && request.resource.data.best <= 9000000000000000
        && request.resource.data.get('wins', 0) in [0, 1]
        && request.resource.data.at == request.time;
      allow update: if lbWriter(uid, ['best', 'at', 'wins'])
        && request.resource.data.best is number && request.resource.data.best >= resource.data.best && request.resource.data.best <= 9000000000000000
        && request.resource.data.get('wins', 0) is int
        && (request.resource.data.get('wins', 0) == resource.data.get('wins', 0) || request.resource.data.get('wins', 0) == resource.data.get('wins', 0) + 1)
        && (request.resource.data.best > resource.data.best || request.resource.data.get('wins', 0) == resource.data.get('wins', 0) + 1 || nickChanged())
        && request.resource.data.at == request.time;
      // vendégfiók összevonása: a moderátor a regisztrált fiók eredményét csak növelheti, a vendégét törölheti
      allow create, update: if perm('moderate') && request.resource.data.keys().hasOnly(['best', 'at', 'wins', 'merged']) && request.resource.data.merged is string
        && request.resource.data.best is number && request.resource.data.best > 0 && request.resource.data.best <= 9000000000000000
        && request.resource.data.get('wins', 0) is int && request.resource.data.at == request.time
        && (resource == null || (!('nick' in resource.data) && request.resource.data.best >= resource.data.best && request.resource.data.get('wins', 0) >= resource.data.get('wins', 0)));
      // eredmény törlése: admin és tulaj; vendégét a moderátor is (összevonáskor)
      allow delete: if perm('publishMedia') || (perm('moderate') && 'nick' in resource.data);
    }

    // ---------- közös nézés ----------
    match /parties/{pid} {
      allow read: if signedIn();
      allow create: if canPost() && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'vid', 'state', 't', 'at', 'createdAt', 'members'])
        && request.resource.data.state in ['play', 'pause'];
      allow update: if (signedIn() && resource.data.host == request.auth.uid
          && changed().hasOnly(['state', 't', 'at', 'members']) && request.resource.data.state in ['play', 'pause'])
        || (signedIn() && changed().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if (signedIn() && resource.data.host == request.auth.uid) || perm('deleteMessages');
      // jelenlét: mindenki a saját dokumentumát írja (75 mp-enként)
      match /viewers/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /msgs/{mid} {
        allow read: if signedIn();
        allow create: if canPost() && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || perm('deleteMessages');
      }
    }

    // ---------- értékelések gyűjteménycsoportként (statisztika, legjobbra értékelt, profil) ----------
    match /{path=**}/ratings/{rid} {
      allow read: if signedIn();
    }

    // Arcade heti bajnok jelölő
    match /meta/arcade {
      allow read: if signedIn();
      allow write: if perm('manageTags');
    }

    // tulajdonos jelölő (az első admin igénylésekor jön létre)
    match /meta/owner {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ---------- csatornák (Discord-szerű üzenőfalak) ----------
    // rangokhoz kötött csatorna: roles = rangkulcsok listája (üres / hiányzik: mindenki); a tulaj és az admin mindent lát
    function chanOk(cid) {
      let r = get(/databases/$(db)/documents/channels/$(cid)).data.get('roles', []);
      return r.size() == 0 || isOwner() || myRole() == 'admin' || myRole() in r;
    }
    match /channels/{cid} {
      allow read: if active();
      allow create, delete: if perm('manageChannels');
      allow update: if perm('manageChannels') || (canPost() && changed().hasOnly(['lastMessageAt']) && chanOk(cid));

      match /messages/{mid} {
        allow read: if active() && chanOk(cid);
        allow create: if canPost() && chanOk(cid) && validMsg()
          && (get(/databases/$(db)/documents/channels/$(cid)).data.get('type', 'text') != 'announce' || perm('announce'));
        allow update: if msgUpdate();
        allow delete: if (active() && resource.data.uid == request.auth.uid) || (perm('deleteMessages') && resource.data.uid != ownerId());
      }
    }

    // ---------- barátok ----------
    // friends/{a_b}: a két uid ábécérendben. Kérelem: from → to, 'pending'; csak a címzett fogadhatja el.
    // Bármelyik fél törölheti (elutasítás, visszavonás, barát eltávolítása).
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendPath(a, b) { return /databases/$(db)/documents/friends/$(pairId(a, b)); }
    // csak get(): ha nincs ilyen dokumentum, a kifejezés hibára fut = nem barátok (így 1 olvasás / ellenőrzés)
    function areFriends(a, b) { return get(friendPath(a, b)).data.status == 'accepted'; }
    function friendOrMe(m) { return m == request.auth.uid || areFriends(request.auth.uid, m); }
    // legfeljebb 8 új tag egy lépésben (a szabályok dokumentum-olvasási kerete miatt)
    function allFriends(l) {
      return l.size() <= 8
        && (l.size() < 1 || friendOrMe(l[0])) && (l.size() < 2 || friendOrMe(l[1])) && (l.size() < 3 || friendOrMe(l[2]))
        && (l.size() < 4 || friendOrMe(l[3])) && (l.size() < 5 || friendOrMe(l[4])) && (l.size() < 6 || friendOrMe(l[5]))
        && (l.size() < 7 || friendOrMe(l[6])) && (l.size() < 8 || friendOrMe(l[7]));
    }
    // ---- többjátékos szobák (js/net.js): WebRTC-bemutatkozás. A meccs alatt nem írunk ide. ----
    // vis: akik a szobát a listájukban látják és beléphetnek (a gazda barátai / meghívottjai) – a belépésnél a barátságot külön is ellenőrizzük
    function roomOk(d) {
      return d.keys().hasOnly(['host', 'hostName', 'game', 'mode', 'map', 'max', 'open', 'state', 'members', 'vis', 'createdAt', 'updatedAt'])
        && d.host is string && d.hostName is string && d.hostName.size() <= 40
        && d.game in ['vizagyuio', 'drift', 'locsolohaboru', 'kohovar'] && d.mode is string && d.mode.size() <= 16 && d.map is string && d.map.size() <= 16
        && d.max is int && d.max >= 2 && d.max <= 8 && d.open is bool && d.state in ['lobby', 'play']
        && d.members is list && d.members.size() >= 1 && d.members.size() <= d.max
        && d.vis is list && d.vis.size() <= 100 && d.updatedAt == request.time;
    }
    match /rooms/{rid} {
      allow get: if signedIn();   // a szobaazonosító maga a meghívó; a dokumentumban csak azonosítók és beállítások vannak
      allow list: if signedIn() && (request.auth.uid in resource.data.vis || request.auth.uid in resource.data.members);
      allow create: if active() && roomOk(request.resource.data)
        && request.resource.data.host == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.state == 'lobby' && request.resource.data.createdAt == request.time;
      allow update: if active() && roomOk(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.game == resource.data.game
        && (
          // a gazda: beállítások, láthatóság, állapot; tagot csak kivehet (és ki is léphet)
          (resource.data.host == request.auth.uid && request.resource.data.host == resource.data.host
            && resource.data.members.hasAll(request.resource.data.members))
          // belépés: csak a gazda barátja, ha szerepel a vis listán és van hely
          || (changed().hasOnly(['members', 'updatedAt']) && !(request.auth.uid in resource.data.members)
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.auth.uid in resource.data.vis && areFriends(request.auth.uid, resource.data.host))
          // kilépés
          || (changed().hasOnly(['members', 'updatedAt']) && request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
          // gazdaváltás: egy bent lévő tag veszi át a kiesett gazda helyét
          || (changed().hasOnly(['host', 'hostName', 'updatedAt']) && request.auth.uid in resource.data.members
            && request.resource.data.host == request.auth.uid)
        );
      // a gazda törölheti; elárvult (2 óránál régebbi) szobát bármelyik tagja
      allow delete: if signedIn() && (resource.data.host == request.auth.uid
        || (request.auth.uid in resource.data.members && resource.data.updatedAt < request.time - duration.value(2, 'h')));
      match /sig/{sid} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'to', 'k', 'n', 'd', 'name', 'at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.k in ['offer', 'answer'] && request.resource.data.d is string && request.resource.data.d.size() <= 12000
          && request.auth.uid in get(/databases/$(db)/documents/rooms/$(rid)).data.members
          && request.resource.data.to in get(/databases/$(db)/documents/rooms/$(rid)).data.members;
        allow read, delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }
    // ---- többjátékos statisztika: mindenki a sajátját növeli, meccsenként korlátozott lépésekben, legfeljebb 45 mp-enként ----
    function mpStep(k, mx) { return request.resource.data.get(k, 0) is int && request.resource.data.get(k, 0) >= resource.data.get(k, 0) && request.resource.data.get(k, 0) - resource.data.get(k, 0) <= mx; }
    function mpNew(k, mx) { return request.resource.data.get(k, 0) is int && request.resource.data.get(k, 0) >= 0 && request.resource.data.get(k, 0) <= mx; }
    match /mpstats/{uid} {
      allow read: if signedIn();
      allow create: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'kos', 'boss', 'm_volgy', 'm_aszaly', 'm_gyar', 'm_atemelo', 'updatedAt'])
        && request.resource.data.games == 1 && mpNew('wins', 1) && mpNew('kos', 40) && mpNew('boss', 1)
        && mpNew('m_volgy', 1) && mpNew('m_aszaly', 1) && mpNew('m_gyar', 1) && mpNew('m_atemelo', 1)
        && request.resource.data.updatedAt == request.time;
      allow update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'kos', 'boss', 'm_volgy', 'm_aszaly', 'm_gyar', 'm_atemelo', 'updatedAt'])
        && request.resource.data.games == resource.data.games + 1 && mpStep('wins', 1) && mpStep('kos', 40) && mpStep('boss', 1)
        && mpStep('m_volgy', 1) && mpStep('m_aszaly', 1) && mpStep('m_gyar', 1) && mpStep('m_atemelo', 1)
        && request.resource.data.updatedAt == request.time && resource.data.updatedAt < request.time - duration.value(45, 's');
    }
    // ---- Locsolóháború statisztika: ugyanaz a minta, mint az mpstats-nál ----
    match /fpsstats/{uid} {
      allow read: if signedIn();
      allow create: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'kos', 'caps', 'boss', 'm_kert', 'm_gyar', 'm_atemelo', 'm_aszaly', 'updatedAt'])
        && request.resource.data.games == 1 && mpNew('wins', 1) && mpNew('kos', 60) && mpNew('caps', 5) && mpNew('boss', 1)
        && mpNew('m_kert', 1) && mpNew('m_gyar', 1) && mpNew('m_atemelo', 1) && mpNew('m_aszaly', 1)
        && request.resource.data.updatedAt == request.time;
      allow update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'kos', 'caps', 'boss', 'm_kert', 'm_gyar', 'm_atemelo', 'm_aszaly', 'updatedAt'])
        && request.resource.data.games == resource.data.games + 1 && mpStep('wins', 1) && mpStep('kos', 60) && mpStep('caps', 5) && mpStep('boss', 1)
        && mpStep('m_kert', 1) && mpStep('m_gyar', 1) && mpStep('m_atemelo', 1) && mpStep('m_aszaly', 1)
        && request.resource.data.updatedAt == request.time && resource.data.updatedAt < request.time - duration.value(60, 's');
    }
    // ---- játékmentések (egyelőre Az Átemelőtelep): mindenki csak a sajátját írja, ritkán, kis méretben ----
    // ---------- felhőmentés idle játékokhoz (Öntöző Birodalom): csak a saját, és csak nagyobb/egyenlő összbevétellel írható felül ----------
    match /cloudsaves/{uid}/g/{game} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid && game in ['birodalom', 'flightsim', 'vizfuvar', 'szerver', 'szerver2', 'szerver3', 'kohovar']
        && request.resource.data.keys().hasOnly(['life', 'lg', 'st', 'updatedAt'])
        && request.resource.data.life is number && request.resource.data.life >= 0 && request.resource.data.life <= 9000000000000000
        && request.resource.data.get('lg', 0) is number
        && request.resource.data.st is string && request.resource.data.st.size() <= 900000
        && request.resource.data.updatedAt == request.time
        && (resource == null || ((request.resource.data.get('lg', 0) >= resource.data.get('lg', 0) || resource.data.life > 9000000000000000) && resource.data.updatedAt < request.time - duration.value(10, 's')));
    }

    match /gamesaves/{uid} {
      allow read: if signedIn();   // a kitüntetésekhez a profilon (állapot, idő – nincs benne érzékeny adat)
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['atemelo', 'updatedAt'])
        && request.resource.data.atemelo is map
        && request.resource.data.atemelo.keys().hasOnly(['ch', 't', 'done', 'best', 'nospill', 'nogas', 'st'])
        && request.resource.data.atemelo.ch is int && request.resource.data.atemelo.ch >= 1 && request.resource.data.atemelo.ch <= 7
        && request.resource.data.atemelo.t is int && request.resource.data.atemelo.t >= 0
        && request.resource.data.atemelo.done is list && request.resource.data.atemelo.done.size() <= 6
        && request.resource.data.atemelo.best is int && request.resource.data.atemelo.nospill in [0, 1] && request.resource.data.atemelo.nogas in [0, 1]
        && request.resource.data.atemelo.st is string && request.resource.data.atemelo.st.size() <= 12000
        && request.resource.data.updatedAt == request.time
        && (resource == null || resource.data.updatedAt < request.time - duration.value(10, 's'));
    }
    match /friends/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if active()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && fid == pairId(request.auth.uid, request.resource.data.to)
        && request.resource.data.users == (request.auth.uid < request.resource.data.to
              ? [request.auth.uid, request.resource.data.to] : [request.resource.data.to, request.auth.uid])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(db)/documents/users/$(request.resource.data.to))
        && get(/databases/$(db)/documents/users/$(request.resource.data.to)).data.get('banned', false) != true;
      allow update: if active() && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ---------- privát üzenetek és csoportok ----------
    // Privát (dm) beszélgetést csak barátok indíthatnak és csak barátok írhatnak bele;
    // csoportba csak a meghívó barátai kerülhetnek.
    match /conversations/{cid} {
      function dmOk(d) { return d.type != 'dm' || areFriends(d.members[0], d.members[1]); }
      allow read: if active() && request.auth.uid in resource.data.members;

      allow create: if canPost()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50
        && request.resource.data.type in ['dm', 'group']
        && ((request.resource.data.type == 'group' && allFriends(request.resource.data.members.removeAll([request.auth.uid])))
            || (request.resource.data.members.size() == 2
                && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                && areFriends(request.resource.data.members[0], request.resource.data.members[1])));

      allow update: if active() && request.auth.uid in resource.data.members && (
        changed().hasOnly(['reads'])
        || (dmOk(resource.data) && changed().hasOnly(['lastMessage', 'updatedAt', 'reads']))
        || (resource.data.type == 'group'
          && changed().hasOnly(['name', 'members', 'updatedAt', 'lastMessage', 'reads'])
          && request.resource.data.members.size() <= 50
          && ((request.resource.data.members.hasAll(resource.data.members)                        // tag hozzáadása (csak barát)
                && allFriends(request.resource.data.members.removeAll(resource.data.members)))
              || (!(request.auth.uid in request.resource.data.members)                            // kilépés
                  && resource.data.members.hasAll(request.resource.data.members)
                  && request.resource.data.members.size() == resource.data.members.size() - 1)
              || (resource.data.owner == request.auth.uid                                         // tulaj eltávolít
                  && resource.data.members.hasAll(request.resource.data.members))))
      );

      allow delete: if active() && resource.data.get('owner', '') == request.auth.uid;

      match /messages/{mid} {
        function members() { return getAfter(/databases/$(db)/documents/conversations/$(cid)).data.members; }
        allow read: if active() && request.auth.uid in get(/databases/$(db)/documents/conversations/$(cid)).data.members;
        allow create: if canPost() && request.auth.uid in members() && validMsg()
          && dmOk(getAfter(/databases/$(db)/documents/conversations/$(cid)).data);
        allow update: if request.auth.uid in members() && msgUpdate();
        allow delete: if active() && resource.data.uid == request.auth.uid;
      }
    }

    // ================= Öntöző Birodalom Online =================
    // bo/{szezon}                  – a világ: közös víztorony, ostrom, vezetékek, szennyezés, tanácsi szavazatok (egy kis dokumentum)
    // bo/{szezon}/players/{uid}    – a játékos állása. A telek a kliensen szimulálódik, ide csak az eredmény kerül,
    //                                ezért minden növekedésnek felső korlátja van a szint és az eltelt idő alapján.
    // bo/{szezon}/regions/{régió}  – régiónként EGY összesítő dokumentum: melyik telek kié, mikor kapott vizet
    // bo/{szezon}/deals/{id}       – piaci ajánlatok (letéttel) és vezetékdíjak
    // bo/{szezon}/coops/{id}       – szövetkezetek · bo/{szezon}/votes/{uid} – tanácsválasztás · bohall/{szezon} – a szezon legjobbjai
    // A számok (árak, korlátok, élek) a js/bo-data.js táblázataival egyeznek – együtt kell módosítani őket.
    function boSid() { return string(request.time.year()) + '-' + (request.time.month() < 10 ? '0' : '') + string(request.time.month()); }
    function boPrev() {
      return request.time.month() == 1 ? string(request.time.year() - 1) + '-12'
        : string(request.time.year()) + '-' + (request.time.month() < 11 ? '0' : '') + string(request.time.month() - 1);
    }
    function boDay() { return boSid() + '-' + (request.time.day() < 10 ? '0' : '') + string(request.time.day()); }
    function boWeek() { return int(request.time.toMillis() / 604800000); }
    function boRules() { return ['olcsoviz', 'bopiac', 'gyorsno', 'eros', 'hirnev']; }
    function boRes() { return ['viz', 'buza', 'virag', 'gomba', 'gyogy', 'so', 'hal', 'krist', 'kaktusz', 'goz', 'asvany', 'jeg', 'eso', 'sziv', 'holdpor', 'csviz', 'alk', 'gep', 'szv', 'hir', 'vjog', 'lfd', 'alf', 'hajo']; }
    function boTrade() { return ['viz', 'buza', 'virag', 'gomba', 'gyogy', 'so', 'hal', 'krist', 'kaktusz', 'goz', 'asvany', 'jeg', 'eso', 'sziv', 'holdpor', 'csviz', 'alk', 'gep', 'szv']; }
    // állami felvásárlás: legfeljebb ennyit fizet darabjáért (alapár × 1,25 – a „Bő piac” szabály miatt)
    function boSell() { return {'viz': 0.25, 'buza': 2.5, 'virag': 3.75, 'gomba': 5, 'gyogy': 6.25, 'so': 6.25, 'hal': 7.5, 'krist': 15, 'kaktusz': 11.25, 'goz': 12.5, 'asvany': 15, 'jeg': 12.5, 'eso': 17.5, 'sziv': 35, 'holdpor': 40, 'csviz': 56.25, 'alk': 75, 'gep': 625}; }
    function boPrice() { return {'volgy': 300, 'atemelo': 1200, 'mocsar': 800, 'obol': 1500, 'gyar': 2000, 'studio': 2000, 'aszaly': 2500, 'gejzir': 4000, 'eszak': 6000, 'felho': 9000, 'hold': 15000}; }
    function boRegLv() { return {'volgy': 1, 'atemelo': 2, 'mocsar': 2, 'obol': 3, 'gyar': 3, 'studio': 3, 'aszaly': 4, 'gejzir': 5, 'eszak': 6, 'felho': 7, 'hold': 8}; }
    function boEdges() { return ['vizvar-volgy', 'gyar-vizvar', 'studio-vizvar', 'atemelo-volgy', 'atemelo-mocsar', 'obol-volgy', 'gyar-obol', 'aszaly-gyar', 'aszaly-gejzir', 'eszak-mocsar', 'eszak-studio', 'felho-gejzir', 'felho-hold']; }
    function boDock() { return ['locsolo', 'nyomas', 'vizagyu', 'csepp', 'viztorony', 'drift', 'holtvaros']; }
    function boCoopName(n) { return n is string && n.size() >= 3 && n.size() <= 24 && n.matches('^[^<>&"]+$') && !reservedName(n) && !badName(n); }
    function boTop(rv, r) {
      return rv.get(r, 0) > 0 && rv.get(r, 0) >= rv.get('olcsoviz', 0) && rv.get(r, 0) >= rv.get('bopiac', 0) && rv.get(r, 0) >= rv.get('gyorsno', 0)
        && rv.get(r, 0) >= rv.get('eros', 0) && rv.get(r, 0) >= rv.get('hirnev', 0);
    }
    // az új szezon szabálya: az előző szezon tanácsválasztásán a legtöbb szavazatot kapott program (ha volt szavazás)
    function boRuleOk(r) {
      return exists(/databases/$(db)/documents/bo/$(boPrev())) && get(/databases/$(db)/documents/bo/$(boPrev())).data.rv.size() > 0
        ? (r in boRules() && boTop(get(/databases/$(db)/documents/bo/$(boPrev())).data.rv, r)) : r == '';
    }
    match /bohall/{sid} {
      allow read: if signedIn();
      allow create, update: if perm('manageTags');
    }
    match /bo/{sid} {
      function my() { return request.auth.uid; }
      function live() { return active() && sid == boSid(); }
      function PP(u) { return /databases/$(db)/documents/bo/$(sid)/players/$(u); }
      function WW() { return /databases/$(db)/documents/bo/$(sid); }
      function DD(d) { return /databases/$(db)/documents/bo/$(sid)/deals/$(d); }
      function RR(r) { return /databases/$(db)/documents/bo/$(sid)/regions/$(r); }
      function CC(c) { return /databases/$(db)/documents/bo/$(sid)/coops/$(c); }
      function VV(u) { return /databases/$(db)/documents/bo/$(sid)/votes/$(u); }
      function meB() { return get(PP(my())).data; }          // a játékos a művelet előtt
      function meA() { return getAfter(PP(my())).data; }     // … és utána (ugyanabban a kötegben)

      // ---------- a világ ----------
      function twOld() { return resource.data.tw.wk == boWeek() ? resource.data.tw.v : 0; }
      function raidNew() { return resource.data.raid.wk != boWeek(); }
      function raidOld() { return raidNew() ? 0 : resource.data.raid.dmg; }
      function rdOld(d) { return d.rd.wk == boWeek() ? d.rd.d : 0; }
      function feeOk(f) { return f is int && f >= 0 && f <= 5; }
      // közös víztorony: annyival nő, amennyi vizet a játékos bead
      function boTower() {
        return request.resource.data.op == 'tw' && changed().hasOnly(['tw', 'op'])
          && request.resource.data.tw.keys().hasOnly(['wk', 'v']) && request.resource.data.tw.wk == boWeek()
          && request.resource.data.tw.v > twOld() && meA().txk == 'tw'
          && request.resource.data.tw.v - twOld() <= meB().inv.get('viz', 0) - meA().inv.get('viz', 0);
      }
      // heti ostrom: a közös sebzés pontosan annyival nő, amennyivel a játékos saját sebzése
      function boRaid() {
        return request.resource.data.op == 'raid' && changed().hasOnly(['raid', 'rp', 'op'])
          && request.resource.data.raid.keys().hasOnly(['wk', 'dmg']) && request.resource.data.raid.wk == boWeek()
          && (raidNew() ? (request.resource.data.rp.keys().hasOnly(['wk', 'ok']) && request.resource.data.rp.wk == resource.data.raid.wk && request.resource.data.rp.ok == (resource.data.raid.dmg >= 4000))
                        : request.resource.data.rp == resource.data.rp)
          && request.resource.data.raid.dmg > raidOld() && meA().txk == 'raid'
          && request.resource.data.raid.dmg - raidOld() == meA().rd.d - rdOld(meB());
      }
      // hétváltás ostrom nélkül: az előző hét eredményének rögzítése
      function boRoll() {
        return request.resource.data.op == 'roll' && changed().hasOnly(['raid', 'rp', 'op']) && raidNew()
          && request.resource.data.raid.keys().hasOnly(['wk', 'dmg']) && request.resource.data.raid.wk == boWeek() && request.resource.data.raid.dmg == 0
          && request.resource.data.rp.keys().hasOnly(['wk', 'ok']) && request.resource.data.rp.wk == resource.data.raid.wk && request.resource.data.rp.ok == (resource.data.raid.dmg >= 4000);
      }
      function pipeDiff() { return request.resource.data.pipes.diff(resource.data.pipes).affectedKeys().hasOnly([request.resource.data.lk]); }
      function pipeNew() { return request.resource.data.pipes[request.resource.data.lk]; }
      // régiók közti vezeték építése (3000 Ft + 20 alkatrész) és a díj állítása
      function boPipe() {
        return request.resource.data.op == 'pipe' && changed().hasOnly(['pipes', 'op', 'lk'])
          && request.resource.data.lk in boEdges() && !(request.resource.data.lk in resource.data.pipes) && pipeDiff()
          && pipeNew().keys().hasOnly(['o', 'fee']) && pipeNew().o == my() && feeOk(pipeNew().fee)
          && meA().txk == 'pipe' && meA().ft <= meB().ft - 3000 && meA().inv.get('alk', 0) <= meB().inv.get('alk', 0) - 20;
      }
      function boFee() {
        return request.resource.data.op == 'fee' && changed().hasOnly(['pipes', 'op', 'lk'])
          && request.resource.data.lk in resource.data.pipes && resource.data.pipes[request.resource.data.lk].o == my() && pipeDiff()
          && pipeNew().keys().hasOnly(['o', 'fee']) && pipeNew().o == my() && feeOk(pipeNew().fee);
      }
      // tanácsválasztás (a hónap 22. napjától): egy tag egy szavazat, a jelölt programja is kap egy szavazatot
      function progOf(c) { return get(PP(c)).data.prog; }
      function boVote() {
        return request.resource.data.op == 'vote' && changed().hasOnly(['cv', 'rv', 'op', 'lk']) && request.time.day() >= 22
          && !exists(VV(my())) && getAfter(VV(my())).data.c == request.resource.data.lk
          && get(PP(request.resource.data.lk)).data.cand == true && progOf(request.resource.data.lk) in boRules()
          && request.resource.data.cv.diff(resource.data.cv).affectedKeys().hasOnly([request.resource.data.lk])
          && request.resource.data.cv[request.resource.data.lk] == resource.data.cv.get(request.resource.data.lk, 0) + 1
          && request.resource.data.rv.diff(resource.data.rv).affectedKeys().hasOnly([progOf(request.resource.data.lk)])
          && request.resource.data.rv[progOf(request.resource.data.lk)] == resource.data.rv.get(progOf(request.resource.data.lk), 0) + 1;
      }
      // túlcsordulás az Átemelőtelepen: a mocsár koszosabb lesz (és a hibázó 50 szennyvizet veszít)
      function boKosz() {
        return request.resource.data.op == 'kosz' && changed().hasOnly(['kosz', 'op'])
          && request.resource.data.kosz.keys().hasOnly(['wk', 'v']) && request.resource.data.kosz.wk == boWeek()
          && request.resource.data.kosz.v == (resource.data.kosz.wk == boWeek() ? resource.data.kosz.v : 0) + 1
          && meA().txk == 'kosz' && meA().inv.get('szv', 0) <= meB().inv.get('szv', 0) - 50;
      }
      allow read: if signedIn();
      allow create: if live()
        && request.resource.data.keys().hasOnly(['t0', 'tw', 'raid', 'rp', 'pipes', 'cv', 'rv', 'kosz', 'rule', 'op', 'lk'])
        && request.resource.data.t0 == request.time
        && request.resource.data.tw.keys().hasOnly(['wk', 'v']) && request.resource.data.tw.wk == boWeek() && request.resource.data.tw.v == 0
        && request.resource.data.raid.keys().hasOnly(['wk', 'dmg']) && request.resource.data.raid.wk == boWeek() && request.resource.data.raid.dmg == 0
        && request.resource.data.kosz.keys().hasOnly(['wk', 'v']) && request.resource.data.kosz.wk == boWeek() && request.resource.data.kosz.v == 0
        && request.resource.data.rp.keys().hasOnly(['wk', 'ok']) && request.resource.data.rp.wk == 0 && request.resource.data.rp.ok == false
        && request.resource.data.pipes == {} && request.resource.data.cv == {} && request.resource.data.rv == {}
        && request.resource.data.op == '' && request.resource.data.lk == ''
        && boRuleOk(request.resource.data.rule);
      allow update: if live() && exists(PP(my())) && request.resource.data.keys().hasOnly(['t0', 'tw', 'raid', 'rp', 'pipes', 'cv', 'rv', 'kosz', 'rule', 'op', 'lk'])
        && (boTower() || boRaid() || boRoll() || boPipe() || boFee() || boVote() || boKosz());

      match /votes/{vid} {
        allow read: if signedIn() && vid == request.auth.uid;
        allow create: if live() && vid == my() && request.resource.data.keys().hasOnly(['c', 'at'])
          && request.resource.data.c is string && request.resource.data.at == request.time
          && getAfter(WW()).data.op == 'vote' && getAfter(WW()).data.lk == request.resource.data.c
          && getAfter(WW()).data.cv[request.resource.data.c] == get(WW()).data.cv.get(request.resource.data.c, 0) + 1;
      }

      // ---------- játékos ----------
      // eltelt idő (mp) az előző elszámolás óta, legfeljebb 12 óra; ha az „at” nem változik, nincs időalapú jóváírás
      function boDt(o, n) {
        return n.at != request.time ? 0.0
          : (request.time.toMillis() - o.at.toMillis() > 43200000 ? 43200.0 : (request.time.toMillis() - o.at.toMillis()) / 1000.0);
      }
      // egy nyersanyag: nem lehet negatív, és legfeljebb „a” darabbal nőhet
      function rk(o, n, ch, k, a) { return !(k in ch) || (n.inv[k] >= 0 && n.inv[k] <= o.inv.get(k, 0) + a && n.inv[k] <= 10000000); }
      function dock(o, n) {
        return n.txk == 'dock' && n.ad == boDay() && o.ad != boDay() && n.get('adg', '') in boDock()
          && get(/databases/$(db)/documents/leaderboards/$(n.adg)/scores/$(my())).data.at > request.time - duration.value(1, 'd');
      }
      // vízjog: pénzért (legalább 200 Ft/db), vagy naponta egy az Arcade-dokkban (ha aznap rekordot döntött a nap játékában)
      function vjOk(o, n, ch) {
        return !('vjog' in ch) || (n.inv.vjog >= 0 && (n.inv.vjog <= o.inv.get('vjog', 0)
          || (dock(o, n) && n.inv.vjog == o.inv.get('vjog', 0) + 1)
          || (n.inv.vjog <= o.inv.get('vjog', 0) + 10 && n.ft <= o.ft - 200 * (n.inv.vjog - o.inv.get('vjog', 0)))));
      }
      // Locsolófej-darab: csak sikeres heti ostrom után, a saját sebzés szerint (100 / 600 / 2000 sebzés: 1 / 2 / 3 darab)
      function lfOk(o, n, ch) {
        return !('lfd' in ch) || (n.inv.lfd >= 0 && (n.inv.lfd <= o.inv.get('lfd', 0)
          || (n.rd.cl == true && o.rd.cl == false && o.rd.wk == get(WW()).data.rp.wk && get(WW()).data.rp.ok == true
            && n.inv.lfd <= o.inv.get('lfd', 0) + (o.rd.d >= 2000 ? 3 : o.rd.d >= 600 ? 2 : o.rd.d >= 100 ? 1 : 0))));
      }
      // Arany Locsolófej: 7 darabból önthető · léghajó: 10 gépből
      function alfOk(o, n, ch) { return !('alf' in ch) || (n.inv.alf >= 0 && (n.inv.alf <= o.inv.get('alf', 0) || (n.inv.alf == o.inv.get('alf', 0) + 1 && n.inv.get('lfd', 0) <= o.inv.get('lfd', 0) - 7))); }
      function hajoOk(o, n, ch) { return !('hajo' in ch) || (n.inv.hajo >= 0 && (n.inv.hajo <= o.inv.get('hajo', 0) || (n.inv.hajo == o.inv.get('hajo', 0) + 1 && n.inv.get('gep', 0) <= o.inv.get('gep', 0) - 10))); }
      // ostrom: a sebzés legfeljebb a beadott víz + 20 × alkatrész 1,25-szöröse, és a világ közös sebzése ugyanennyivel nő
      function rdOk(o, n) {
        return n.rd.keys().hasOnly(['wk', 'd', 'cl']) && (n.rd == o.rd
          || (n.rd.wk == o.rd.wk && n.rd.d == o.rd.d && n.rd.cl == true)
          || (n.txk == 'raid' && n.rd.wk == boWeek() && n.rd.cl == (o.rd.wk == boWeek() ? o.rd.cl : false) && n.rd.d is int && n.rd.d > rdOld(o)
            && n.rd.d - rdOld(o) <= 1.25 * ((o.inv.get('viz', 0) - n.inv.get('viz', 0)) + 20 * (o.inv.get('alk', 0) - n.inv.get('alk', 0)))
            && getAfter(WW()).data.raid.dmg - (get(WW()).data.raid.wk == boWeek() ? get(WW()).data.raid.dmg : 0) == n.rd.d - rdOld(o)));
      }
      // szintlépés: egyszerre egy szint, 150 × szint² Ft, és szintenként legalább fél óra a szezonba lépés óta
      function lvOk(o, n) { return n.lv == o.lv || (n.lv == o.lv + 1 && n.lv <= 30 && request.time.toMillis() - o.t0.toMillis() >= (n.lv - 1) * 1800000); }
      function lvCost(o, n) { return n.lv == o.lv ? 0 : 150 * n.lv * n.lv; }
      // új telek: a régió összesítőjében ugyanebben a kötegben a játékosé lesz; kiszáradt telek negyedáron
      function plotNew(o, n) {
        return n.txk == 'plot' && n.tx in boPrice() && n.pl.size() <= 1 + o.lv / 2
          && n.pl.keys().toSet().difference(o.pl.keys().toSet()).hasOnly([n.tx + '_' + n.txp])
          && getAfter(RR(n.tx)).data.plots[n.txp].u == my();
      }
      function plotCost(o, n) {
        return n.pl.keys().hasOnly(o.pl.keys()) ? 0
          : (exists(RR(n.tx)) && n.txp in get(RR(n.tx)).data.plots ? boPrice()[n.tx] / 4 : boPrice()[n.tx]);
      }
      function scOk(n) { return n.sc is number && n.sc <= n.lv * 1000 + n.ft / 10 + n.inv.get('hir', 0) * 5 + n.inv.get('lfd', 0) * 500 + n.inv.get('alf', 0) * 5000 + n.pl.size() * 200 + 1; }
      function miscOk(o, n) {
        return (n.coop == o.coop || n.coop == '' || my() in getAfter(CC(n.coop)).data.m)
          && n.cos is list && n.cos.size() <= 20 && (n.cos == o.cos || n.inv.get('hir', 0) <= o.inv.get('hir', 0) - 100)
          && n.cand is bool && (n.prog == '' || n.prog in boRules()) && n.voted is bool && n.ad is string && n.ad.size() <= 10;
      }
      // általános módosítás: időarányos termelés + költések (szint, telek, vízjog, épületek)
      function boGen(o, n) {
        let dt = boDt(o, n);
        let ch = n.inv.diff(o.inv).affectedKeys();
        let aR = 0.04 * o.lv * dt;
        return n.txk in ['', 'plot', 'offer', 'tw', 'raid', 'pipe', 'kosz', 'give', 'coop', 'water', 'dock']
          && ch.hasOnly(boRes())
          && rk(o, n, ch, 'viz', 0.6 * o.lv * dt) && rk(o, n, ch, 'szv', 0.3 * o.lv * dt)
          && rk(o, n, ch, 'buza', aR) && rk(o, n, ch, 'virag', aR) && rk(o, n, ch, 'gomba', aR) && rk(o, n, ch, 'gyogy', aR) && rk(o, n, ch, 'so', aR)
          && rk(o, n, ch, 'hal', aR) && rk(o, n, ch, 'krist', aR) && rk(o, n, ch, 'kaktusz', aR) && rk(o, n, ch, 'goz', aR) && rk(o, n, ch, 'asvany', aR)
          && rk(o, n, ch, 'jeg', aR) && rk(o, n, ch, 'eso', aR) && rk(o, n, ch, 'sziv', aR) && rk(o, n, ch, 'holdpor', aR) && rk(o, n, ch, 'csviz', aR)
          && rk(o, n, ch, 'alk', 0.004 * o.lv * dt) && rk(o, n, ch, 'gep', 0.0004 * o.lv * dt) && rk(o, n, ch, 'hir', 0.01 * o.lv * dt)
          && vjOk(o, n, ch) && lfOk(o, n, ch) && alfOk(o, n, ch) && hajoOk(o, n, ch)
          && n.ft >= 0 && n.ft <= o.ft + 0.3 * o.lv * dt + (dock(o, n) ? 300 : 0) - lvCost(o, n) - plotCost(o, n)
          && lvOk(o, n) && n.pl is map && n.pl.size() <= 16 && (n.pl.keys().hasOnly(o.pl.keys()) || plotNew(o, n))
          && rdOk(o, n) && miscOk(o, n) && (n.ad == o.ad || dock(o, n));
      }
      // kereskedés: egyetlen ügylethez kötött módosítás (időarányos jóváírás nélkül)
      function dB(n) { return get(DD(n.tx)).data; }
      function dA(n) { return getAfter(DD(n.tx)).data; }
      function one(o, n, k) { return n.inv.diff(o.inv).affectedKeys().hasOnly([k]) && n.inv.get(k, 0) >= 0; }
      function boTr(o, n) {
        return n.at == o.at && n.diff(o).affectedKeys().hasOnly(['inv', 'ft', 'sc', 'tx', 'txp', 'txk']) && n.ft >= 0 && (
          // eladás az állami felvásárlónak
          (n.txk == 'sell' && n.tx in boSell() && one(o, n, n.tx) && n.inv[n.tx] < o.inv[n.tx] && n.ft <= o.ft + (o.inv[n.tx] - n.inv[n.tx]) * boSell()[n.tx])
          // vétel a piacon: az ajánlat ebben a kötegben kel el
          || (n.txk == 'buy' && dB(n).st == 'open' && dA(n).st == 'sold' && dA(n).b == my() && one(o, n, dB(n).res)
            && n.inv[dB(n).res] <= o.inv.get(dB(n).res, 0) + dB(n).q && n.ft <= o.ft - dB(n).p)
          // saját ajánlat visszavonása: a letét visszajár
          || (n.txk == 'cancel' && dB(n).k == 'offer' && dB(n).st == 'open' && dB(n).s == my() && !existsAfter(DD(n.tx)) && one(o, n, dB(n).res)
            && n.inv[dB(n).res] <= o.inv.get(dB(n).res, 0) + dB(n).q && n.ft <= o.ft)
          // az eladott áru / a vezetékdíj árának felvétele
          || (n.txk == 'collect' && dB(n).st == 'sold' && dB(n).s == my() && !existsAfter(DD(n.tx)) && n.inv == o.inv && n.ft <= o.ft + dB(n).p)
          // víz behozatala vezetéken: 1 Ft/liter + a tulajdonos díja
          || (n.txk == 'import' && !exists(DD(n.tx)) && dA(n).k == 'toll' && dA(n).b == my() && one(o, n, 'viz')
            && n.inv.viz <= o.inv.get('viz', 0) + dA(n).q && n.ft <= o.ft - dA(n).p - dA(n).q));
      }
      match /players/{pid} {
        allow read: if signedIn();
        allow create: if live() && pid == my()
          && request.resource.data.keys().hasOnly(['lv', 'ft', 'inv', 'pl', 'sc', 'coop', 'cos', 'rd', 'ad', 'cand', 'prog', 'voted', 'tx', 'txp', 'txk', 't0', 'at'])
          && request.resource.data.lv == 1 && request.resource.data.ft == 500 && request.resource.data.inv == {'viz': 200, 'vjog': 1}
          && request.resource.data.pl == {} && request.resource.data.sc == 1050 && request.resource.data.coop == '' && request.resource.data.cos == []
          && request.resource.data.rd.keys().hasOnly(['wk', 'd', 'cl']) && request.resource.data.rd.wk == 0 && request.resource.data.rd.d == 0 && request.resource.data.rd.cl == false
          && request.resource.data.ad == '' && request.resource.data.cand == false && request.resource.data.prog == '' && request.resource.data.voted == false
          && request.resource.data.tx == '' && request.resource.data.txp == '' && request.resource.data.txk == ''
          && request.resource.data.t0 == request.time && request.resource.data.at == request.time;
        allow update: if live() && pid == my()
          && request.resource.data.keys().hasOnly(['lv', 'ft', 'inv', 'pl', 'sc', 'coop', 'cos', 'rd', 'ad', 'adg', 'cand', 'prog', 'voted', 'tx', 'txp', 'txk', 't0', 'at'])
          && request.resource.data.t0 == resource.data.t0 && (request.resource.data.at == request.time || request.resource.data.at == resource.data.at)
          && request.resource.data.lv is int && request.resource.data.ft is number && request.resource.data.tx is string && request.resource.data.txp is string
          && scOk(request.resource.data)
          && (request.resource.data.txk in ['sell', 'buy', 'cancel', 'collect', 'import']
            ? boTr(resource.data, request.resource.data) : boGen(resource.data, request.resource.data));
      }

      // ---------- régió: egyetlen összesítő dokumentum, benne a telkek (kulcs: 0–47) ----------
      // egy írás egy telket érint (lk); a telek 72 óra víz nélkül kiszárad, és bárki felvásárolhatja
      function regBuy(op, n, rid) {
        let k = n.lk;
        return n.op == 'buy' && k.matches('^([0-9]|[1-3][0-9]|4[0-7])$')
          && (!(k in op) || (op[k].u != my() && op[k].wt < request.time - duration.value(72, 'h')))
          && n.plots[k].keys().hasOnly(['u', 'wt', 'lv']) && n.plots[k].u == my() && n.plots[k].wt == request.time && n.plots[k].lv == 1
          && meB().lv >= boRegLv()[rid]
          && meA().txk == 'plot' && meA().tx == rid && meA().txp == k
          && (rid + '_' + k) in meA().pl && !((rid + '_' + k) in meB().pl);
      }
      function regOwn(op, n) {
        let k = n.lk;
        return k in op && op[k].u == my() && (
          // öntözés: 20 liter vízbe kerül, és frissíti az időbélyeget
          (n.op == 'water' && n.plots[k].keys().hasOnly(['u', 'wt', 'lv']) && n.plots[k].u == my() && n.plots[k].wt == request.time && n.plots[k].lv == op[k].lv
            && meA().txk == 'water' && meA().inv.get('viz', 0) <= meB().inv.get('viz', 0) - 20)
          || (n.op == 'up' && n.plots[k].keys().hasOnly(['u', 'wt', 'lv']) && n.plots[k].u == my() && n.plots[k].wt == op[k].wt
            && n.plots[k].lv is int && n.plots[k].lv >= 1 && n.plots[k].lv <= 10)
          || (n.op == 'leave' && !(k in n.plots)));
      }
      match /regions/{rid} {
        allow read: if signedIn();
        allow create: if live() && rid in boPrice() && request.resource.data.keys().hasOnly(['plots', 'lk', 'op'])
          && request.resource.data.plots.keys().hasOnly([request.resource.data.lk]) && regBuy({}, request.resource.data, rid);
        allow update: if live() && changed().hasOnly(['plots', 'lk', 'op'])
          && request.resource.data.plots.diff(resource.data.plots).affectedKeys().hasOnly([request.resource.data.lk])
          && (regBuy(resource.data.plots, request.resource.data, rid) || regOwn(resource.data.plots, request.resource.data));
      }

      // ---------- piac: ajánlatok letéttel + vezetékdíjak ----------
      // idegennek csak nyilvános ajánlat tehető; névre szóló (közvetlen) ajánlat csak barátnak
      match /deals/{did} {
        allow read: if active();
        allow create: if live() && meA().tx == did && request.resource.data.at == request.time
          && request.resource.data.q is int && request.resource.data.q > 0 && request.resource.data.q <= 1000000 && (
          (request.resource.data.keys().hasOnly(['k', 's', 'to', 'pub', 'res', 'q', 'p', 'st', 'b', 'at'])
            && request.resource.data.k == 'offer' && request.resource.data.s == my() && request.resource.data.st == 'open' && request.resource.data.b == ''
            && request.resource.data.res in boTrade()
            && request.resource.data.p is int && request.resource.data.p >= 0 && request.resource.data.p <= 100000000
            && ((request.resource.data.to == '' && request.resource.data.pub == true)
              || (request.resource.data.pub == false && request.resource.data.to != my() && areFriends(my(), request.resource.data.to)))
            && meA().txk == 'offer'
            && meA().inv.get(request.resource.data.res, 0) <= meB().inv.get(request.resource.data.res, 0) - request.resource.data.q)
          || (request.resource.data.keys().hasOnly(['k', 's', 'b', 'pipe', 'q', 'p', 'st', 'at'])
            && request.resource.data.k == 'toll' && request.resource.data.b == my() && request.resource.data.st == 'sold'
            && request.resource.data.pipe in get(WW()).data.pipes
            && request.resource.data.s == get(WW()).data.pipes[request.resource.data.pipe].o
            && request.resource.data.p == request.resource.data.q * get(WW()).data.pipes[request.resource.data.pipe].fee
            && meA().txk == 'import'));
        allow update: if live() && resource.data.k == 'offer' && resource.data.st == 'open' && resource.data.s != my()
          && (resource.data.to == '' || resource.data.to == my())
          && changed().hasOnly(['st', 'b', 'pub']) && request.resource.data.st == 'sold' && request.resource.data.b == my() && request.resource.data.pub == false
          && meA().tx == did && meA().txk == 'buy';
        allow delete: if active() && resource.data.s == my() && meA().tx == did && meA().txk in ['cancel', 'collect'];
      }

      // ---------- szövetkezetek (legfeljebb 10 fő; belépni csak meghívottként lehet) ----------
      function coopGive() { return (request.resource.data.p.torony + request.resource.data.p.portal) - (resource.data.p.torony + resource.data.p.portal); }
      match /coops/{cid} {
        allow read: if signedIn();
        allow create: if live() && request.resource.data.keys().hasOnly(['n', 'cr', 'o', 'm', 'inv', 'p', 'op', 'at'])
          && boCoopName(request.resource.data.n) && request.resource.data.cr is string && request.resource.data.cr.size() <= 8
          && request.resource.data.o == my() && request.resource.data.m == [my()] && request.resource.data.inv == []
          && request.resource.data.p.keys().hasOnly(['torony', 'portal']) && request.resource.data.p.torony == 0 && request.resource.data.p.portal == 0
          && request.resource.data.at == request.time
          && meB().coop == '' && meB().lv >= 3 && meA().coop == cid && meA().txk == 'coop' && meA().ft <= meB().ft - 2000;
        allow update: if live() && request.resource.data.keys().hasOnly(['n', 'cr', 'o', 'm', 'inv', 'p', 'op', 'at']) && (
          (request.resource.data.op == 'join' && changed().hasOnly(['m', 'inv', 'op'])
            && my() in resource.data.inv && !(my() in resource.data.m) && resource.data.m.size() < 10
            && request.resource.data.m == resource.data.m.concat([my()]) && request.resource.data.inv == resource.data.inv.removeAll([my()])
            && meB().coop == '' && meA().coop == cid)
          || (request.resource.data.op == 'leave' && changed().hasOnly(['m', 'op'])
            && my() != resource.data.o && my() in resource.data.m && request.resource.data.m == resource.data.m.removeAll([my()]))
          || (request.resource.data.op == 'own' && resource.data.o == my() && changed().hasOnly(['m', 'inv', 'n', 'cr', 'op'])
            && my() in request.resource.data.m && resource.data.m.hasAll(request.resource.data.m)
            && request.resource.data.inv is list && request.resource.data.inv.size() <= 20
            && boCoopName(request.resource.data.n) && request.resource.data.cr is string && request.resource.data.cr.size() <= 8)
          // közös építmény (víztorony, vízportál): alkatrész beadása
          || (request.resource.data.op == 'give' && changed().hasOnly(['p', 'op']) && my() in resource.data.m
            && request.resource.data.p.keys().hasOnly(['torony', 'portal'])
            && request.resource.data.p.torony >= resource.data.p.torony && request.resource.data.p.portal >= resource.data.p.portal
            && coopGive() > 0 && meA().txk == 'give' && coopGive() <= meB().inv.get('alk', 0) - meA().inv.get('alk', 0)));
        allow delete: if active() && resource.data.o == my() && resource.data.m.size() == 1;
      }
    }

    // ---------- filmek ----------
    // A film adatai (cím, poszter, állapot) nyilvánosak – a főoldal ezekből mutatja az előzetest.
    match /videos/{id} {
      allow read: if true;
      allow write: if perm('publishMedia');

      // hozzászólások a filmekhez (a vendég olvashatja, de nem írhat)
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if canPost() && validMsg();
        allow update: if msgUpdate();
        allow delete: if (active() && resource.data.uid == request.auth.uid) || (perm('deleteMessages') && resource.data.uid != ownerId());
      }

      // csillagos értékelés: dokumentum-azonosító = a tag uid-ja, így mindenki csak egyszer értékelhet
      match /ratings/{rid} {
        allow read: if signedIn();
        allow create, update: if active() && rid == request.auth.uid
          && request.resource.data.keys().hasOnly(['stars', 'at'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.at == request.time;
        allow delete: if (active() && rid == request.auth.uid) || (perm('deleteMessages') && rid != ownerId());
      }
    }
    // Zenék: belépett tagok és vendégek hallgathatják, csak admin kezeli.
    match /music/{id} {
      allow read: if signedIn();
      allow write: if perm('publishMedia');
    }
    // A videó forrása csak belépett tagoknak és vendégeknek látszik (a lejátszóhoz kell).
    // ---------- élő premier: a vetítés állapota (vezérlő, zár, szünet), nézők, vége; csevegés ----------
    // a vezérlő (master) irányít; bárki a saját jelenlétét frissítheti; a vége és a hossz egyszer írható be bárki által
    match /premieres/{vid} {
      allow read: if true;
      allow create, delete: if perm('publishMedia');
      allow update: if perm('publishMedia')
        || (signedIn() && resource.data.master == request.auth.uid
          && changed().hasOnly(['state', 't', 'at', 'locked', 'members'])
          && request.resource.data.state in ['auto', 'play', 'pause'] && request.resource.data.t is number
          && request.resource.data.locked is bool && request.resource.data.at == request.time)
        || (signedIn() && resource.data.master == request.auth.uid && changed().hasOnly(['locked']) && request.resource.data.locked is bool)
        || (signedIn() && changed().hasOnly(['view']) && request.resource.data.view.keys().hasOnly(['n', 'u', 'at'])
          && request.resource.data.view.n is int && request.resource.data.view.u is list && request.resource.data.view.u.size() <= 30
          && request.resource.data.view.at == request.time)
        || (signedIn() && changed().hasOnly(['endedAt']) && !('endedAt' in resource.data) && request.resource.data.endedAt == request.time)
        || (signedIn() && changed().hasOnly(['dur']) && !('dur' in resource.data) && request.resource.data.dur is number
          && request.resource.data.dur > 0 && request.resource.data.dur < 36000);
      // jelenlét: mindenki a saját dokumentumát írja (75 mp-enként)
      match /viewers/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /msgs/{mid} {
        allow read: if signedIn();
        allow create: if canPost() && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || perm('deleteMessages');
      }
    }

    match /videoSources/{id} {
      allow read: if perm('publishMedia') || signedIn();
      allow write: if perm('publishMedia');
    }
  }
}
